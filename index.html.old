      { e: "📱", c: "„daj znać, jak dotrzesz”" },
      { e: "☂️", c: "jeden parasol dla dwojga" },
      { e: "🛋️", c: "film i czyjeś ramię" }
    ];

    /*************************************************************************
     * STREAMING_CHUNK:Running the Canvas background particle engine...
     *************************************************************************/
    const canvas = document.getElementById('bg-canvas');
    const ctx = canvas.getContext('2d');
    let bgMode = 'none';
    let particles = [];

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function setBgParticles(mode) {
      bgMode = mode;
      particles = [];
      const count = mode === 'rain' ? 140 : mode === 'stars' ? 120 : mode === 'dust' ? 160 : mode === 'petals' ? 55 : mode === 'matrix' ? 70 : 0;
      for (let i = 0; i < Math.round(count * (window.innerWidth < 640 ? 0.6 : 1)); i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 1.2,
          vy: Math.random() * 2.8 + 1.4,
          size: Math.random() * 3 + 1,
          alpha: Math.random() * 0.8 + 0.2,
          char: ['0', '1', '<', '/', '3', '?', '#', '%'][Math.floor(Math.random() * 8)]
        });
      }
    }

    function animateCanvas() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (bgMode === 'rain') {
        ctx.strokeStyle = 'rgba(185, 210, 255, 0.45)';
        ctx.lineWidth = 1.5;
        particles.forEach(p => {
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(p.x - 2, p.y + 20);
          ctx.stroke();
          p.y += p.vy * 5.5;
          p.x -= 0.8;
          if (p.y > canvas.height) { p.y = -20; p.x = Math.random() * canvas.width; }
        });
      } else if (bgMode === 'stars' || bgMode === 'dust') {
        particles.forEach(p => {
          ctx.fillStyle = bgMode === 'dust' ? `rgba(96, 165, 250, ${p.alpha})` : `rgba(255, 255, 255, ${p.alpha})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size * 0.9, 0, Math.PI * 2);
          ctx.fill();
          p.y -= p.vy * 0.4;
          p.x += p.vx;
          if (p.y < 0) p.y = canvas.height;
          if (p.x > canvas.width) p.x = 0;
          if (p.x < 0) p.x = canvas.width;
        });
      } else if (bgMode === 'petals') {
        particles.forEach(p => {
          ctx.fillStyle = `rgba(244, 114, 182, ${p.alpha * 0.7})`;
          ctx.beginPath();
          ctx.ellipse(p.x, p.y, p.size * 2.2, p.size, p.x * 0.02, 0, Math.PI * 2);
          ctx.fill();
          p.y += p.vy * 0.8;
          p.x += Math.sin(p.y * 0.02) * 0.9;
          if (p.y > canvas.height) { p.y = -10; p.x = Math.random() * canvas.width; }
        });
      } else if (bgMode === 'matrix') {
        ctx.font = '13px JetBrains Mono';
        particles.forEach(p => {
          ctx.fillStyle = `rgba(239, 68, 68, ${p.alpha * 0.6})`;
          ctx.fillText(p.char, p.x, p.y);
          p.y += p.vy * 2.2;
          if (p.y > canvas.height) { p.y = -10; p.x = Math.random() * canvas.width; }
        });
      }
      requestAnimationFrame(animateCanvas);
    }
    animateCanvas();

    /*************************************************************************
     * STREAMING_CHUNK:Managing the cinematic director state and timeline...
     *************************************************************************/
    const stage = document.getElementById('cinematic-stage');
    const themeBgLayer = document.getElementById('theme-bg-layer');
    const flashOverlay = document.getElementById('flash-overlay');
    const timelineBar = document.getElementById('timeline-bar');
    const themePicker = document.getElementById('theme-picker');
    const hudTopLeft = document.getElementById('hud-top-left');
    const hudBottomLeft = document.getElementById('hud-bottom-left');
    const hudBottomRight = document.getElementById('hud-bottom-right');

    let activeFilm = null;
    let timers = [];
    let recInterval = null;
    let recSeconds = 0;

    FILMS.forEach(f => {
      const opt = document.createElement('option');
      opt.value = f.id;
      opt.textContent = f.title;
      opt.className = "bg-zinc-900 text-white";
      themePicker.appendChild(opt);
    });

    function clearAllTimers() {
      timers.forEach(t => clearTimeout(t));
      timers = [];
    }

    function schedule(fn, delay) {
      const t = setTimeout(fn, delay);
      timers.push(t);
    }

    function triggerFlashAndShake(intense = false) {
      flashOverlay.style.opacity = intense ? '0.65' : '0.22';
      setTimeout(() => { flashOverlay.style.opacity = '0'; }, 160);

      document.body.classList.remove('shake-screen', 'beat-pulse');
      void document.body.offsetWidth;
      document.body.classList.add(intense ? 'shake-screen' : 'beat-pulse');
    }

    function pickRandomFilm() {
      let lastId = 0;
      try {
        lastId = parseInt(sessionStorage.getItem('last_lonely_film_id') || '0', 10);
      } catch (e) {}
      const pool = FILMS.filter(f => f.id !== lastId);
      const chosen = pool[Math.floor(Math.random() * pool.length)];
      try {
        sessionStorage.setItem('last_lonely_film_id', chosen.id);
      } catch (e) {}
      return chosen;
    }

    function startRecClock() {
      clearInterval(recInterval);
      recSeconds = 0;
      recInterval = setInterval(() => {
        recSeconds++;
        const mins = String(Math.floor(recSeconds / 60)).padStart(2, '0');
        const secs = String(recSeconds % 60).padStart(2, '0');
        hudTopLeft.textContent = `REC 00:${mins}:${secs}`;
      }, 1000);
    }

    /*************************************************************************
     * PERSONALIZACJA, TELEFON, WARSTWY EFEKTÓW
     *************************************************************************/
    const USER = { name: '', nameUp: '' };
    let BATTERY = null;
    const isMobile = (window.matchMedia && matchMedia('(pointer: coarse)').matches) || window.innerWidth < 640;

    const heartbreakLayer = document.getElementById('heartbreak-layer');
    const tunnelLayer = document.getElementById('tunnel-layer');
    const pulseLayer = document.getElementById('pulse-layer');
    const dimLayer = document.getElementById('dim-layer');
    const desatLayer = document.getElementById('desat-layer');
    const lensLayer = document.getElementById('lens-layer');
    const notifEl = document.getElementById('notif');
    const HEART_PATH = "M23.6,0c-3.4,0-6.3,2.7-7.6,5.6C14.7,2.7,11.8,0,8.4,0C3.8,0,0,3.8,0,8.4c0,9.4,9.5,11.9,16,21.2c6.1-9.3,16-12.1,16-21.2C32,3.8,28.2,0,23.6,0z";
    const isLightFilm = (f) => [4, 5, 10].includes(f.id);

    function nowStr() {
      const d = new Date();
      return `${d.getHours()}:${String(d.getMinutes()).padStart(2, '0')}`;
    }
    function fill(s) {
      if (!s) return '';
      return s
        .replace(/\{(imie|IMIE)(?:\|([^}]*))?\}/g, (m, k, fb) => {
          if (USER.name) return k === 'IMIE' ? USER.nameUp : USER.name;
          if (fb !== undefined) return fb;
          return k === 'IMIE' ? 'TY' : 'ty';
        })
        .replace(/\{godz\}/g, nowStr());
    }
    function haptic(pattern) {
      if (!isMobile || audio.muted || !navigator.vibrate) return;
      try { navigator.vibrate(pattern); } catch (e) {}
    }
    function setDesat(v, instant = false) {
      desatLayer.classList.toggle('instant', instant);
      desatLayer.style.opacity = String(v);
      if (instant) setTimeout(() => desatLayer.classList.remove('instant'), 80);
    }
    function letterbox(on) { document.body.classList.toggle('letterbox-on', on); }
    function playBeatSfx(list) {
      (list || []).forEach((s) => {
        const [name, d] = s.split('@');
        audio.sfx(name, parseInt(d || '0', 10));
      });
    }

    function showNotif(n) {
      if (!n) return;
      const set = (title, body) => {
        document.getElementById('notif-title').textContent = fill(title);
        document.getElementById('notif-body').textContent = fill(body);
        document.getElementById('notif-body').style.display = body ? '' : 'none';
      };
      document.getElementById('notif-icon').textContent = n.icon;
      document.getElementById('notif-app').textContent = fill(n.app);
      set(n.title, n.body);
      notifEl.classList.remove('sad');
      notifEl.classList.add('show');
      audio.sfx('vibrate');
      audio.sfx('notif', 150);
      haptic([40, 80, 40]);
      schedule(() => {
        notifEl.classList.add('sad');
        set(n.title2, n.body2);
        const txt = document.getElementById('notif-text');
        txt.classList.remove('swap');
        void txt.offsetWidth;
        txt.classList.add('swap');
        audio.sfx('notifSad');
        haptic(20);
      }, 2100);
      schedule(() => notifEl.classList.remove('show'), 5400);
    }

    function spawnLensTears(n, spreadMs = 4000) {
      for (let i = 0; i < n; i++) {
        schedule(() => {
          const d = document.createElement('div');
          d.className = 'lens-drop';
          d.style.setProperty('--s', `${14 + Math.random() * 26}px`);
          d.style.setProperty('--d', `${5 + Math.random() * 4}s`);
          d.style.left = `${8 + Math.random() * 84}%`;
          d.style.top = `${5 + Math.random() * 40}%`;
          lensLayer.appendChild(d);
          setTimeout(() => d.remove(), 10000);
        }, Math.random() * spreadMs);
      }
    }

    /*************************************************************************
     * EFEKTY 3D: odłamki serca, tunel gwiazd, łzy
     *************************************************************************/
    class FX3D {
      constructor(cv) {
        this.cv = cv;
        this.c = cv.getContext('2d');
        this.parts = [];
        this.stars = [];
        this.tears = [];
        this.warpUntil = 0;
        this.tearsOn = false;
        this.scale = isMobile ? 0.6 : 1;
        this.resize();
        window.addEventListener('resize', () => this.resize());
        for (let i = 0; i < Math.round(220 * this.scale); i++) this.stars.push(this.newStar(true));
        this.loop = this.loop.bind(this);
        requestAnimationFrame(this.loop);
      }
      resize() {
        this.dpr = Math.min(isMobile ? 1.5 : 2, window.devicePixelRatio || 1);
        this.w = window.innerWidth;
        this.h = window.innerHeight;
        this.cv.width = this.w * this.dpr;
        this.cv.height = this.h * this.dpr;
        this.cv.style.width = this.w + 'px';
        this.cv.style.height = this.h + 'px';
        this.c.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      }
      newStar(randomZ) {
        return { x: (Math.random() - 0.5) * 2000, y: (Math.random() - 0.5) * 2000, z: randomZ ? Math.random() * 2000 + 10 : 2000 };
      }
      reset() { this.parts = []; this.warpUntil = 0; this.setTears(false); }
      burst(n = 180, soft = false) {
        n = Math.round(n * this.scale);
        for (let i = 0; i < n; i++) {
          const a = Math.random() * Math.PI * 2;
          const b = Math.acos(2 * Math.random() - 1);
          const sp = soft ? 2 + Math.random() * 5 : 6 + Math.random() * 18;
          this.parts.push({
            x: 0, y: 0, z: 0,
            vx: Math.sin(b) * Math.cos(a) * sp,
            vy: Math.sin(b) * Math.sin(a) * sp - (soft ? 1 : 3),
            vz: Math.cos(b) * sp * 1.4,
            rot: Math.random() * 6.28,
            vr: (Math.random() - 0.5) * 0.3,
            size: soft ? 2 + Math.random() * 4 : 4 + Math.random() * 14,
            life: 1,
            decay: soft ? 0.012 + Math.random() * 0.01 : 0.006 + Math.random() * 0.008,
            type: Math.random() < (soft ? 0.6 : 0.3) ? 'heart' : 'shard',
            hue: 340 + Math.random() * 25,
            light: 45 + Math.random() * 20
          });
        }
      }
      warp(ms) { this.warpUntil = performance.now() + ms; }
      setTears(on) { this.tearsOn = on; if (!on) this.tears = []; }
      heart(c, s) {
        c.beginPath();
        c.moveTo(0, -s * 0.25);
        c.bezierCurveTo(-s * 0.5, -s * 0.9, -s * 1.2, -s * 0.05, 0, s * 0.8);
        c.bezierCurveTo(s * 1.2, -s * 0.05, s * 0.5, -s * 0.9, 0, -s * 0.25);
        c.fill();
      }
      loop(now) {
        const c = this.c, cx = this.w / 2, cy = this.h / 2;
        c.clearRect(0, 0, this.w, this.h);

        if (now < this.warpUntil) {
          const k = Math.min(1, (this.warpUntil - now) / 600);
          const f = Math.min(this.w, this.h) * 0.8;
          c.lineCap = 'round';
          for (const s of this.stars) {
            const z0 = s.z;
            s.z -= 60;
            if (s.z < 5) { Object.assign(s, this.newStar(false)); continue; }
            c.strokeStyle = `rgba(255, ${150 + (s.z / 20 | 0)}, 180, ${0.65 * k})`;
            c.lineWidth = Math.max(0.5, 3.2 - s.z / 650);
            c.beginPath();
            c.moveTo(cx + (s.x / z0) * f, cy + (s.y / z0) * f);
            c.lineTo(cx + (s.x / s.z) * f, cy + (s.y / s.z) * f);
            c.stroke();
          }
        }

        const F = Math.min(this.w, this.h) * 0.9;
        for (let i = this.parts.length - 1; i >= 0; i--) {
          const p = this.parts[i];
          p.x += p.vx; p.y += p.vy; p.z += p.vz;
          p.vy += 0.22; p.vx *= 0.985; p.vz *= 0.985;
          p.rot += p.vr;
          p.life -= p.decay;
          if (p.z < -F * 0.85 || p.life <= 0) { this.parts.splice(i, 1); continue; }
          const s = F / (F + p.z);
          const size = p.size * s;
          c.save();
          c.translate(cx + p.x * s, cy + p.y * s);
          c.rotate(p.rot);
          c.globalAlpha = Math.max(0, Math.min(1, p.life * 1.4));
          c.fillStyle = `hsl(${p.hue}, 100%, ${p.light}%)`;
          if (p.type === 'heart') {
            this.heart(c, size);
          } else {
            c.beginPath();
            c.moveTo(0, -size);
            c.lineTo(size * 0.6, size * 0.5);
            c.lineTo(-size * 0.4, size * 0.7);
            c.closePath();
            c.fill();
          }
          c.restore();
        }

        if (this.tearsOn) {
          if (this.tears.length < 90 * this.scale && Math.random() < 0.6) {
            this.tears.push({ x: (Math.random() - 0.5) * this.w * 1.6, y: -this.h * 0.7 - Math.random() * 200, z: Math.random() * 900, vy: 3 + Math.random() * 4 });
          }
          for (let i = this.tears.length - 1; i >= 0; i--) {
            const d = this.tears[i];
            d.y += d.vy;
            d.vy += 0.03;
            const s = F / (F + d.z);
            const sx = cx + d.x * s, sy = cy + d.y * s;
            if (sy > this.h + 30) { this.tears.splice(i, 1); continue; }
            c.globalAlpha = 0.25 + 0.5 * s;
            c.fillStyle = 'rgba(190, 220, 255, 0.9)';
            c.beginPath();
            c.ellipse(sx, sy, 1.6 * s + 0.6, 7 * s + 2, 0, 0, Math.PI * 2);
            c.fill();
          }
          c.globalAlpha = 1;
        }
        requestAnimationFrame(this.loop);
      }
    }
    const fx = new FX3D(document.getElementById('fx-canvas'));

    // bicie serca: puls na ekranie + wibracja telefonu w chwilach napięcia
    audio.onHeartbeat = (vol) => {
      pulseLayer.style.setProperty('--pulse-strength', Math.min(0.65, 0.1 + vol * 0.55).toFixed(2));
      pulseLayer.classList.remove('pulse-beat');
      void pulseLayer.offsetWidth;
      pulseLayer.classList.add('pulse-beat');
      if (vol >= 0.55) haptic([22, 150, 14]);
    };

    function escapeHtml(s) {
      return s.replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));
    }

    function letters3D(text, baseDelay = 0, step = 45) {
      let i = 0;
      return '<span class="letters-3d">' + text.split(' ').map((w) =>
        `<span class="word-3d">${Array.from(w).map((ch) =>
          `<span class="letter-3d" style="animation-delay:${baseDelay + (i++) * step}ms">${escapeHtml(ch)}</span>`
        ).join('')}</span>`
      ).join(' ') + '</span>';
    }

    function extrudedText(text) {
      const layers = isMobile ? 9 : 14;
      let back = '';
      for (let i = layers; i >= 1; i--) {
        back += `<span class="ex-layer" aria-hidden="true" style="transform: translateZ(${(-i * 2.4).toFixed(1)}px); color: rgb(${150 - i * 7}, 0, ${30 - i})">${escapeHtml(text)}</span>`;
      }
      return `<span class="extrude-wrap"><span class="extrude-enter"><span class="extrude">${back}<span class="ex-front">${letters3D(text, 250, 70)}</span></span></span></span>`;
    }

    function heartBreak(big = false) {
      const half = (side) => `<div class="heart-half ${side}"><svg viewBox="0 0 32 29.6"><path d="${HEART_PATH}" fill="#ff1744"/></svg></div>`;
      heartbreakLayer.innerHTML = `
        <div class="heart-wrap ${big ? 'big' : ''}">
          <div class="heart-glow"></div>
          ${half('left')}${half('right')}
          <svg class="crack-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
            <polyline pathLength="100" points="50,19 45,34 55,50 44,66 53,82 50,100" />
          </svg>
        </div>`;
      setTimeout(() => { heartbreakLayer.innerHTML = ''; }, 2400);
    }

    function crackSVG(cx = 50, cy = 55) {
      let lines = '';
      const n = 11;
      for (let i = 0; i < n; i++) {
        const ang = (i / n) * Math.PI * 2 + Math.random() * 0.4;
        let x = cx, y = cy;
        const pts = [`${x},${y}`];
        const segs = 3 + (Math.random() * 3 | 0);
        for (let s = 0; s < segs; s++) {
          const len = 8 + Math.random() * 16;
          const a = ang + (Math.random() - 0.5) * 0.7;
          x += Math.cos(a) * len;
          y += Math.sin(a) * len;
          pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
        }
        lines += `<polyline pathLength="100" points="${pts.join(' ')}" style="animation-delay:${(Math.random() * 0.12).toFixed(2)}s"/>`;
      }
      return `<svg class="screen-crack" viewBox="0 0 100 100" preserveAspectRatio="none">${lines}</svg>`;
    }

    function tunnelOn(ms) {
      tunnelLayer.innerHTML = Array.from({ length: isMobile ? 6 : 8 }).map((_, i, arr) =>
        `<div class="tunnel-ring" style="animation-delay:${(-i * (2.2 / arr.length)).toFixed(3)}s"><svg viewBox="0 0 32 29.6"><path d="${HEART_PATH}" fill="none" stroke="#ff003c" stroke-width="0.35"/></svg></div>`
      ).join('');
      tunnelLayer.classList.add('on');
      schedule(() => tunnelOff(), ms);
    }
    function tunnelOff() {
      tunnelLayer.classList.remove('on');
      setTimeout(() => { if (!tunnelLayer.classList.contains('on')) tunnelLayer.innerHTML = ''; }, 500);
    }

    function chromaSplit() {
      stage.classList.remove('chroma-split');
      void stage.offsetWidth;
      stage.classList.add('chroma-split');
    }

    function bigHitVisuals(big = false) {
      flashOverlay.style.backgroundColor = '#ffffff';
      triggerFlashAndShake(true);
      setTimeout(() => { flashOverlay.style.backgroundColor = ''; }, 90);
      chromaSplit();
      heartBreak(big);
      tunnelOn(big ? 3200 : 2800);
      fx.burst(big ? 240 : 200);
      fx.warp(big ? 2200 : 1500);
      haptic(big ? [120, 50, 200, 80, 900] : [80, 40, 160, 60, 600]);
    }

    function typewriter(el, text, startDelay, speed) {
      if (!el) return;
      Array.from(text).forEach((ch, i) => {
        schedule(() => { if (el.isConnected) el.textContent += ch; }, startDelay + i * speed);
      });
    }

    function addDots(stream, id, isLight) {
      removeDots(id);
      const d = document.createElement('div');
      d.id = `typing-dots-${id}`;
      d.className = `self-start px-4 py-3 rounded-2xl ${isLight ? 'bg-zinc-200' : 'bg-zinc-800'} flex items-center gap-1.5 w-16 slam-anim`;
      d.innerHTML = `<span class="w-2 h-2 rounded-full bg-zinc-400 t-dot-1"></span><span class="w-2 h-2 rounded-full bg-zinc-400 t-dot-2"></span><span class="w-2 h-2 rounded-full bg-zinc-400 t-dot-3"></span>`;
      stream.appendChild(d);
      stream.scrollTop = stream.scrollHeight;
    }
    function removeDots(id) {
      const d = document.getElementById(`typing-dots-${id}`);
      if (d) d.remove();
    }

    function addMeBubble(stream, text) {
      stream.querySelectorAll('.receipt').forEach((r) => r.remove());
      const wrap = document.createElement('div');
      wrap.className = 'self-end flex flex-col items-end max-w-[82%] slam-anim';
      wrap.innerHTML = `<div class="px-4 py-2.5 rounded-2xl bg-blue-600 text-white text-sm sm:text-base font-medium shadow-md"></div><div class="receipt text-[10px] opacity-60 mt-1 font-mono-code">Dostarczono</div>`;
      wrap.firstElementChild.textContent = text;
      stream.appendChild(wrap);
      stream.scrollTop = stream.scrollHeight;
    }
    function markSeen(stream, label = 'Wyświetlono') {
      const r = stream.querySelector('.receipt');
      if (r) { r.textContent = label; r.classList.add('text-blue-400'); }
    }

    /*************************************************************************
     * REŻYSER
     *************************************************************************/
    function startFilm(film) {
      clearAllTimers();
      activeFilm = film;
      themePicker.value = film.id;
      hudBottomLeft.textContent = fill(film.hudBottom);
      hudBottomRight.textContent = 'AKT I • ROZMOWA NOCĄ';
      timelineBar.style.width = '5%';
      startRecClock();

      setBgParticles(film.bgType);
      document.body.className = `relative w-full h-full overflow-hidden select-none ${film.themeClass}`;
      themeBgLayer.innerHTML = film.id === 2
        ? `<div class="absolute bottom-0 inset-x-0 h-1/2 synth-grid-3d opacity-75"></div>`
        : '';
      heartbreakLayer.innerHTML = '';
      lensLayer.innerHTML = '';
      notifEl.classList.remove('show', 'sad');
      tunnelOff();
      dimLayer.classList.remove('on');
      setDesat(0, true);
      letterbox(false);
      fx.reset();
      stage.classList.remove('chroma-split');

      audio.setKey(film.key || 0);
      audio.setBpm(film.bpm || 64);
      audio.resetForFilm();
      audio.setAmbience(film.ambience || 'none');

      runAct1Chat(film);
    }

    /* ---------- AKT I: rozmowa, nadzieja, napięcie, cios ---------- */
    function runAct1Chat(film) {
      const isLight = isLightFilm(film);
      const headerTime = /^\d{1,2}:\d{2}$/.test(film.time) ? nowStr() : film.time;
      const batt = BATTERY != null ? BATTERY : 3;

      stage.innerHTML = `
        <div class="chat-3d-wrapper w-full max-w-md mx-auto">
          <div id="chat-3d-card" class="chat-3d-plane relative rounded-3xl border ${isLight ? 'bg-white/95 border-black/25 text-zinc-900 shadow-[0_30px_80px_rgba(0,0,0,0.5)]' : 'bg-zinc-950/90 border-white/15 text-white shadow-[0_30px_90px_rgba(0,0,0,0.95)]'} backdrop-blur-xl overflow-hidden">
            <div class="px-4 sm:px-5 py-3 border-b ${isLight ? 'border-black/10 bg-zinc-100' : 'border-white/10 bg-zinc-900/80'} flex items-center justify-between text-xs">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-8 h-8 rounded-full ${isLight ? 'bg-black text-white' : 'bg-white/15 text-white'} flex items-center justify-center font-black uppercase shrink-0">
                  ${escapeHtml(film.partner[0])}
                </div>
                <div class="min-w-0">
                  <div class="font-bold truncate">${escapeHtml(film.partner)}</div>
                  <div class="text-[10px] opacity-60 flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span> aktywny(a) teraz
                  </div>
                </div>
              </div>
              <div class="font-mono-code text-[11px] flex items-center gap-2 shrink-0">
                <span class="opacity-70">Dziś ${escapeHtml(headerTime)}</span>
                <span class="px-1.5 py-0.5 rounded ${batt <= 20 ? 'bg-red-500/20 text-red-400 border-red-500/40' : 'bg-white/10 opacity-70 border-white/20'} border font-bold">${batt <= 20 ? '🪫' : '🔋'} ${batt}%</span>
              </div>
            </div>
            <div id="chat-stream" class="p-4 sm:p-5 space-y-3 min-h-[40dvh] max-h-[48dvh] sm:min-h-[340px] sm:max-h-[370px] overflow-y-auto flex flex-col justify-end"></div>
          </div>
        </div>
      `;

      const stream = document.getElementById('chat-stream');
      const card3d = document.getElementById('chat-3d-card');
      let t = 500;

      film.chat.forEach((msg, index) => {
        const isMe = msg.from === 'me';
        const text = fill(msg.text);

        if (msg.isTwist) {
          // wahanie: „pisze…”, znika, wraca – czas zwalnia
          schedule(() => {
            addDots(stream, 'tw', isLight);
            card3d.style.transform = '';
            card3d.classList.remove('hope-glow');
            card3d.classList.add('tension-push');
            dimLayer.classList.add('on');
            document.body.classList.add('slowmo');
            letterbox(true);
            audio.setHeart(96, 0.6);
            hudBottomRight.textContent = 'AKT I • …';
          }, t);
          schedule(() => removeDots('tw'), t + 1100);
          schedule(() => addDots(stream, 'tw', isLight), t + 1700);
          const hitAt = t + 3400;
          schedule(() => audio.preTwist(1.7), hitAt - 1700);
          schedule(() => doTwist(text, stream, card3d), hitAt);
          t = hitAt + 3800;
          return;
        }

        if (!isMe) {
          schedule(() => addDots(stream, index, isLight), t);
          t += msg.hope ? 1600 : 1150;
        } else {
          t += 800;
        }

        schedule(() => {
          removeDots(index);
          timelineBar.style.width = `${Math.min(35, ((index + 1) / film.chat.length) * 35)}%`;
          audio.setHeart(62 + index * 6, Math.min(0.6, 0.35 + index * 0.04));
          if (isMe) {
            addMeBubble(stream, text);
            audio.messageOut(index);
          } else {
            markSeen(stream);
            audio.messageIn(index);
            haptic(12);
            const bubble = document.createElement('div');
            bubble.className = `self-start px-4 py-2.5 rounded-2xl ${isLight ? 'bg-zinc-200 text-zinc-900' : 'bg-zinc-800 text-zinc-100'} text-sm sm:text-base font-medium max-w-[82%] slam-anim shadow-md`;
            bubble.textContent = text;
            stream.appendChild(bubble);
            if (msg.hope) {
              // chwila nadziei tuż przed ciosem
              bubble.classList.add('hope-bubble');
              card3d.style.transform = '';
              card3d.classList.add('hope-glow');
              audio.sfx('swell');
              audio.sfx('ding', 300);
            } else {
              triggerFlashAndShake(false);
            }
          }
          stream.scrollTop = stream.scrollHeight;
        }, t);

        t += msg.hope ? 1900 : 1300;
      });

      schedule(() => runAct2Montage(film), t);
    }

    function doTwist(text, stream, card3d) {
      removeDots('tw');
      markSeen(stream);
      document.body.classList.remove('slowmo');
      audio.twistImpact(false);
      bigHitVisuals(false);
      schedule(() => dimLayer.classList.remove('on'), 1400);
      schedule(() => setDesat(0.3), 1400);
      schedule(() => letterbox(false), 2800);

      if (card3d) {
        card3d.style.transform = '';
        card3d.classList.remove('tension-push', 'hope-glow');
        card3d.classList.add('twist-zoom');
        card3d.insertAdjacentHTML('beforeend', crackSVG());
      }
      Array.from(stream.children).forEach((el) => {
        el.style.transition = 'filter .6s, opacity .6s';
        el.style.filter = 'blur(4px)';
        el.style.opacity = '0.2';
      });

      const tb = document.createElement('div');
      tb.className = 'twist-bubble my-auto self-center px-7 py-5 rounded-3xl bg-red-600 text-white font-black text-2xl sm:text-4xl tracking-tight text-center border-2 border-red-200 z-20';
      tb.innerHTML = letters3D(text, 450, 60);
      stream.appendChild(tb);
      stream.scrollTop = stream.scrollHeight;
      timelineBar.style.width = '35%';
      hudBottomRight.textContent = 'AKT I • CIOS';
    }

    /* ---------- AKT II: montaż 3D ---------- */
    const ENTRANCES = [
      { ex: '-45vw', ey: '0px', erx: '8deg', ery: '75deg', erz: '-6deg' },
      { ex: '45vw', ey: '0px', erx: '8deg', ery: '-75deg', erz: '6deg' },
      { ex: '0px', ey: '45vh', erx: '-75deg', ery: '0deg', erz: '0deg' },
      { ex: '0px', ey: '-45vh', erx: '75deg', ery: '0deg', erz: '0deg' },
      { ex: '0px', ey: '0px', erx: '0deg', ery: '0deg', erz: '-35deg' },
      { ex: '-20vw', ey: '25vh', erx: '-40deg', ery: '40deg', erz: '12deg' }
    ];

    function exitCurrentScene() {
      const cur = stage.querySelector('.scene-3d-card, .chat-3d-wrapper');
      if (cur) {
        cur.style.setProperty('--xry', `${(Math.random() < 0.5 ? -1 : 1) * (50 + Math.random() * 30)}deg`);
        cur.style.setProperty('--xrx', `${(Math.random() - 0.5) * 30}deg`);
        cur.classList.add('scene-exit');
      }
      audio.whoosh();
    }

    function runAct2Montage(film) {
      let elapsed = 0;
      const totalBeats = film.beats.length;
      const isLight = isLightFilm(film);
      const whispers = film.whispers || [];
      const notifAt = Math.floor((totalBeats - 1) / 2);
      audio.setIntensity(1);
      audio.setHeart(58, 0.2);

      film.beats.forEach((beat, idx) => {
        const sceneDuration = beat.duration + 1900;
        const whisper = fill(whispers[idx % Math.max(1, whispers.length)] || '');
        const en = ENTRANCES[(film.id + idx) % ENTRANCES.length];

        schedule(() => exitCurrentScene(), Math.max(0, elapsed - 420));

        schedule(() => {
          if (idx >= Math.ceil(totalBeats / 2)) audio.setIntensity(2);
          audio.sceneHit(idx);
          playBeatSfx(beat.sfx);
          triggerFlashAndShake(false);
          haptic(25);
          fx.burst(45, true);
          setDesat(0.3 + ((idx + 1) / totalBeats) * 0.35);

          timelineBar.style.width = `${35 + ((idx + 1) / totalBeats) * 40}%`;
          hudBottomRight.textContent = `AKT II • SCENA ${String(idx + 1).padStart(2, '0')}/${String(totalBeats).padStart(2, '0')}`;

          stage.innerHTML = `
            <div class="scene-3d-card enter-var relative w-full max-w-2xl flex flex-col items-center justify-center p-4 sm:p-10 rounded-3xl select-none"
                 style="--ex:${en.ex};--ey:${en.ey};--erx:${en.erx};--ery:${en.ery};--erz:${en.erz}">
              <div class="depth-layer-back">💔</div>
              <div class="depth-layer-glow absolute inset-8 rounded-full ${isLight ? 'bg-red-500/20' : 'bg-red-600/20'} pointer-events-none"></div>
              <div class="depth-layer-front w-full flex flex-col items-center justify-center">
                ${fill(beat.html)}
              </div>
              <div class="depth-layer-mid mt-6 sm:mt-8 pt-4 border-t ${isLight ? 'border-black/15 text-zinc-700' : 'border-white/10 text-zinc-400'} text-center max-w-md">
                <p id="whisper-${idx}" class="font-serif-italic text-sm sm:text-base tracking-wide opacity-95 min-h-[1.6em]"></p>
              </div>
            </div>
          `;
          if (whisper) typewriter(document.getElementById(`whisper-${idx}`), `„${whisper}”`, 900, 36);
          if (film.lensTears && idx === totalBeats - 2) spawnLensTears(5, 3000);
        }, elapsed);

        if (idx === notifAt) schedule(() => showNotif(film.notif), elapsed + 2300);

        elapsed += sceneDuration;
      });

      schedule(() => exitCurrentScene(), elapsed - 420);
      schedule(() => runInterlude(film), elapsed);
    }

    /* ---------- INTERLUDIUM: wiadomość, której nikt nie przeczyta ---------- */
    function runInterlude(film) {
      const isLight = isLightFilm(film);
      const drafts = (film.drafts || ['czy ktoś to przeczyta?', 'czy ktoś kiedyś wybierze mnie?', 'dobranoc']).map(fill);
      audio.setIntensity(0);
      audio.setMusicTone(1400, 1.5);
      audio.setHeart(56, 0.45);
      document.body.classList.add('breathe');
      setDesat(0.65);
      timelineBar.style.width = '80%';
      hudBottomRight.textContent = 'INTERLUDIUM • NIEWYSŁANE';

      stage.innerHTML = `
        <div class="scene-3d-card enter-var relative w-full max-w-md" style="--ex:0px;--ey:12vh;--erx:-45deg;--ery:0deg;--erz:0deg">
          <div class="depth-layer-front w-full">
            <div class="font-mono-code text-[10px] sm:text-[11px] tracking-[0.3em] uppercase opacity-60 mb-4 text-center">${escapeHtml(nowStr())} • wiadomość, której nikt nie przeczyta</div>
            <div class="rounded-3xl border ${isLight ? 'bg-white/95 border-black/20 text-zinc-900' : 'bg-zinc-950/90 border-white/15 text-white'} p-4 sm:p-5 shadow-2xl" style="text-shadow:none">
              <div class="flex items-center gap-2 text-xs pb-3 border-b ${isLight ? 'border-black/10' : 'border-white/10'}">
                <div class="w-7 h-7 rounded-full ${isLight ? 'bg-black text-white' : 'bg-white/15'} flex items-center justify-center font-black uppercase">${escapeHtml(film.partner[0])}</div>
                <b class="truncate">${escapeHtml(film.partner)}</b>
                <span class="ml-auto opacity-50 shrink-0">aktywny(a) przed chwilą</span>
              </div>
              <div id="ilx-stream" class="min-h-[150px] sm:min-h-[170px] flex flex-col justify-end gap-2 py-4"></div>
              <div class="flex items-center gap-2 rounded-full ${isLight ? 'bg-zinc-100' : 'bg-white/10'} px-4 py-3">
                <span id="ilx-input" class="flex-1 text-left text-sm sm:text-base break-words"></span>
                <span class="ilx-caret">|</span>
                <span id="ilx-send" class="text-blue-500 opacity-30 font-bold transition-opacity">➤</span>
              </div>
            </div>
            <p id="ilx-after" class="mt-6 text-center font-serif-italic text-lg sm:text-2xl opacity-0 transition-opacity duration-1000"></p>
          </div>
        </div>`;

      const input = document.getElementById('ilx-input');
      const ilx = document.getElementById('ilx-stream');
      const send = document.getElementById('ilx-send');
      const after = document.getElementById('ilx-after');
      let t = 900;
      let cur = '';

      const typeStr = (str, speed = 65) => {
        Array.from(str).forEach((ch, i) => {
          schedule(() => { input.textContent += ch; send.style.opacity = '1'; audio.keyClick(); }, t + i * speed + Math.random() * 25);
        });
        t += Array.from(str).length * speed + 200;
        cur += str;
      };
      const delAll = (speed = 28) => {
        const n = Array.from(cur).length;
        for (let i = 0; i < n; i++) {
          schedule(() => {
            input.textContent = Array.from(input.textContent).slice(0, -1).join('');
            if (!input.textContent) send.style.opacity = '0.3';
            audio.keyClick(true);
          }, t + i * speed);
        }
        t += n * speed + 200;
        cur = '';
      };
      const wait = (ms) => { t += ms; };

      typeStr(drafts[0]);
      wait(1100);
      delAll();
      schedule(() => audio.sfx('breath'), t);
      wait(1300);
      typeStr(drafts[1]);
      wait(1300);
      delAll(22);
      wait(900);
      typeStr(drafts[2], 105);
      wait(700);

      schedule(() => {
        input.textContent = '';
        send.style.opacity = '0.3';
        addMeBubble(ilx, drafts[2]);
        audio.messageOut(0);
        haptic(15);
      }, t);
      t += 1700;
      schedule(() => { markSeen(ilx, `Wyświetlono ${nowStr()}`); audio.seenSigh(); }, t);
      t += 900;
      schedule(() => addDots(ilx, 'ilx', isLight), t);
      t += 1900;
      schedule(() => { removeDots('ilx'); audio.sighDown(); haptic(30); }, t);
      t += 900;
      schedule(() => {
        after.textContent = 'wyświetlone. bez odpowiedzi. jak zawsze.';
        after.style.opacity = '0.85';
      }, t);
      t += 2800;

      schedule(() => exitCurrentScene(), t - 420);
      schedule(() => runFinaleMemories(film), t);
    }

    /* ---------- AKT III a: wspomnienia, których nie było ---------- */
    function runFinaleMemories(film) {
      document.body.classList.remove('breathe');
      hudBottomRight.textContent = 'AKT III • WSPOMNIENIA';
      timelineBar.style.width = '86%';
      audio.setMusicTone(18000, 2);
      audio.setIntensity(-1);
      audio.setHeart(54, 0.3);
      setDesat(0);

      const picks = [0, 1, 2, 3].map((i) => MEMORIES[(film.id * 3 + i) % MEMORIES.length]);
      const S = Math.min(window.innerWidth * 0.2, 120);
      const pos = [
        { x: -S, y: -S * 1.05, r: '-8deg' },
        { x: S, y: -S * 0.95, r: '6deg' },
        { x: -S * 0.9, y: S * 1.05, r: '5deg' },
        { x: S * 1.05, y: S * 0.95, r: '-7deg' }
      ];

      stage.innerHTML = `
        <div class="scene-3d-card enter-var w-full max-w-xl text-center" style="--ex:0px;--ey:0px;--erx:0deg;--ery:0deg;--erz:0deg">
          <div class="font-hand text-2xl sm:text-3xl text-amber-100">rzeczy, które sobie wyobrażasz…</div>
          <div class="polaroid-stage" id="pol-stage"></div>
          <div id="pol-after" class="font-serif-italic text-xl sm:text-2xl text-zinc-200 opacity-0 transition-opacity duration-1000"></div>
        </div>`;
      const polStage = document.getElementById('pol-stage');

      picks.forEach((m, i) => {
        schedule(() => {
          const p = document.createElement('div');
          p.className = 'polaroid';
          p.style.setProperty('--px', `${pos[i].x.toFixed(0)}px`);
          p.style.setProperty('--py', `${pos[i].y.toFixed(0)}px`);
          p.style.setProperty('--pr', pos[i].r);
          p.innerHTML = `<div class="ph">${m.e}</div><div class="cap">${escapeHtml(m.c)}</div>`;
          polStage.appendChild(p);
          audio.sfx('shutter');
          haptic(10);
        }, 400 + i * 1100);
      });

      schedule(() => {
        polStage.querySelectorAll('.polaroid').forEach((p) => p.classList.add('faded'));
        setDesat(0.85);
        audio.setMusicTone(900, 2);
        audio.sfx('sigh');
      }, 5300);
      schedule(() => {
        const a = document.getElementById('pol-after');
        if (a) { a.textContent = 'żadna z nich się nie wydarzyła.'; a.style.opacity = '0.9'; }
        audio.sfx('heartSkip');
        haptic(60);
      }, 6300);
      schedule(() => {
        polStage.querySelectorAll('.polaroid').forEach((p, i) => setTimeout(() => p.classList.add('fall'), i * 160));
        audio.whoosh(0.9, 0.18);
      }, 7900);
      schedule(() => runFourthWall(film), 9700);
    }

    /* ---------- AKT III b: czwarta ściana ---------- */
    function runFourthWall(film) {
      hudBottomRight.textContent = 'AKT III • …';
      timelineBar.style.width = '90%';
      audio.setAmbience('night');
      audio.setMusicTone(450, 1.5);
      audio.setHeart(52, 0.55);
      letterbox(true);
      const h = new Date().getHours();
      const night = h >= 22 || h < 5;
      const lead = USER.name ? `${escapeHtml(USER.name)}, jest ${nowStr()}.` : `jest ${nowStr()}.`;
      const tail = night ? 'a ty znowu nie śpisz.' : 'a w środku i tak jest noc.';

      stage.innerHTML = `
        <div class="scene-3d-card enter-var text-center max-w-lg mx-auto px-4 fourth-wall" style="--ex:0px;--ey:0px;--erx:0deg;--ery:0deg;--erz:0deg">
          <div class="depth-layer-front space-y-5 text-xl sm:text-3xl text-zinc-200">
            <p class="line" style="animation-delay:.3s">ta historia nie jest o nikim konkretnym.</p>
            <p class="line" style="animation-delay:2.6s">a jednak coś w niej rozpoznajesz.</p>
            <p class="line text-zinc-400 text-lg sm:text-2xl" style="animation-delay:5s">${lead} ${tail}</p>
          </div>
        </div>`;
      schedule(() => audio.sfx('breath'), 2600);
      schedule(() => runAct3Finale(film), 8000);
    }

    /* ---------- AKT III c: finał ---------- */
    function runAct3Finale(film) {
      timelineBar.style.width = '94%';
      hudBottomRight.textContent = 'AKT III • FINAŁ';
      audio.setMusicTone(18000, 2);
      audio.setIntensity(0);
      fx.setTears(true);
      dimLayer.classList.add('on');
      setDesat(0.9);

      stage.innerHTML = `
        <div class="scene-3d-card enter-var text-center max-w-xl mx-auto px-4" style="--ex:0px;--ey:0px;--erx:0deg;--ery:0deg;--erz:0deg">
          <div class="depth-layer-front">
            <div class="text-xs font-mono-code uppercase tracking-[0.3em] opacity-50 mb-4">${escapeHtml(nowStr())} • CISZA</div>
            <div class="text-3xl sm:text-5xl font-serif-italic opacity-90 mb-4">${letters3D('„każdy może znaleźć miłość...”', 100, 40)}</div>
            <p class="text-sm sm:text-base opacity-60 font-light mb-8">tak zawsze mówią ci, którzy nie zasypiają sami.</p>
            <div class="text-7xl sm:text-8xl my-4 animate-pulse">🧍</div>
          </div>
        </div>
      `;
      audio.preTwist(3.2, true);

      schedule(() => {
        timelineBar.style.width = '100%';
        setDesat(0, true);
        audio.twistImpact(true);
        bigHitVisuals(true);
        spawnLensTears(isMobile ? 6 : 9, 6000);
        schedule(() => dimLayer.classList.remove('on'), 1800);
        schedule(() => letterbox(false), 3500);
        schedule(() => setDesat(0.45), 5000);

        const forName = USER.name ? `<div class="font-mono-code text-[10px] tracking-[0.4em] opacity-50 -mt-2 mb-4">— DLA: ${escapeHtml(USER.nameUp)} —</div>` : '';
        stage.innerHTML = `
          <div id="finale-screen" class="scene-3d-card enter-var text-center max-w-2xl mx-auto px-4" style="--ex:0px;--ey:0px;--erx:30deg;--ery:0deg;--erz:0deg">
            <div class="depth-layer-glow absolute inset-10 rounded-full bg-red-600/25 pointer-events-none"></div>
            <div class="depth-layer-front">
              <div class="font-mono-code text-[10px] sm:text-xs uppercase tracking-[0.3em] opacity-60 mb-3">${escapeHtml(film.title)}</div>
              <div class="text-xl sm:text-2xl font-serif-italic opacity-75 mb-2">każdy może znaleźć miłość</div>
              <h1 class="text-5xl sm:text-8xl font-black tracking-tighter my-5 sm:my-6 uppercase leading-none">
                ${extrudedText('(OPRÓCZ CIEBIE)')}
              </h1>
              ${forName}
              <p id="finale-line" class="text-sm sm:text-base font-serif-italic opacity-80 max-w-md mx-auto mb-4 min-h-[3em]"></p>
              <div class="text-5xl my-3 sm:my-5 opacity-85"><span class="finale-figure">🧎💔</span></div>

              <div class="mt-5 sm:mt-8 flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 sm:gap-4">
                <button id="finale-next-btn" class="w-full sm:w-auto px-8 py-4 rounded-full bg-red-600 text-white font-black text-xs sm:text-sm uppercase tracking-widest hover:bg-red-500 transition shadow-[0_0_50px_rgba(220,38,38,0.8)] hover:scale-105">
                  🎲 WYLOSUJ KOLEJNĄ HISTORIĘ (1 Z 17)
                </button>
                <button id="finale-again-btn" class="w-full sm:w-auto px-6 py-4 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-xs sm:text-sm uppercase tracking-wider border border-white/20 transition">
                  ↻ PRZEŻYJ TĘ HISTORIĘ JESZCZE RAZ
                </button>
              </div>
              <p id="ps-line" class="ps-line text-[11px] sm:text-xs font-serif-italic max-w-sm mx-auto mt-6 leading-relaxed">
                p.s. dziś w nocy miliony ludzi czują dokładnie to samo co ty.<br>w samotności nikt nie jest naprawdę sam.
              </p>
            </div>
          </div>
        `;
        typewriter(document.getElementById('finale-line'), 'Niektóre historie nie mają szczęśliwego zakończenia. Po prostu trwają dalej — noc po nocy.', 1600, 40);
        schedule(() => audio.outro(), 4200);
        schedule(() => document.getElementById('ps-line')?.classList.add('show'), 12000);

        document.getElementById('finale-next-btn')?.addEventListener('click', () => {
          const screen = document.getElementById('finale-screen');
          if (screen) screen.classList.add('crt-collapse');
          audio.playGlitchNoise(0.28);
          audio.whoosh(0.5, 0.25);
          setTimeout(() => startFilm(pickRandomFilm()), 550);
        });
        document.getElementById('finale-again-btn')?.addEventListener('click', () => {
          startFilm(activeFilm);
        });
      }, 3200);
    }

    /*************************************************************************
     * TELEFON: dźwięk w trybie cichym (iOS), ekran nie gaśnie, pełny ekran
     *************************************************************************/
    let wakeLock = null;
    let silentEl = null;
    async function requestWakeLock() {
      try { if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen'); } catch (e) {}
    }
    function silentWavURL() {
      const sr = 8000, n = 4000;
      const buf = new ArrayBuffer(44 + n);
      const v = new DataView(buf);
      const w = (o, s) => { for (let i = 0; i < s.length; i++) v.setUint8(o + i, s.charCodeAt(i)); };
      w(0, 'RIFF'); v.setUint32(4, 36 + n, true); w(8, 'WAVE'); w(12, 'fmt ');
      v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);
      v.setUint32(24, sr, true); v.setUint32(28, sr, true); v.setUint16(32, 1, true); v.setUint16(34, 8, true);
      w(36, 'data'); v.setUint32(40, n, true);
      for (let i = 0; i < n; i++) v.setUint8(44 + i, 128);
      return URL.createObjectURL(new Blob([buf], { type: 'audio/wav' }));
    }
    function unlockMobileAudio() {
      try { if (navigator.audioSession) navigator.audioSession.type = 'playback'; } catch (e) {}
      try {
        if (!silentEl) {
          silentEl = document.createElement('audio');
          silentEl.src = silentWavURL();
          silentEl.loop = true;
          silentEl.setAttribute('playsinline', '');
        }
        silentEl.play().catch(() => {});
      } catch (e) {}
    }
    document.addEventListener('visibilitychange', () => {
      if (!audio.ctx) return;
      if (document.hidden) {
        audio.ctx.suspend();
      } else {
        audio.ctx.resume();
        requestWakeLock();
      }
    });

    /*************************************************************************
     * STEROWANIE: mysz, dotyk, żyroskop telefonu
     *************************************************************************/
    function applyTilt(rx, ry) {
      document.documentElement.style.setProperty('--rx', `${rx.toFixed(2)}deg`);
      document.documentElement.style.setProperty('--ry', `${ry.toFixed(2)}deg`);
      const chatCard = document.getElementById('chat-3d-card');
      if (chatCard && !chatCard.classList.contains('twist-zoom') && !chatCard.classList.contains('tension-push') && !chatCard.classList.contains('hope-glow')) {
        const m = isMobile ? 0.45 : 0.7;
        chatCard.style.transform = `rotateX(${(isMobile ? 8 : 12) + rx * m}deg) rotateY(${(isMobile ? -8 : -14) + ry * m}deg) rotateZ(2deg) scale(1.03)`;
      }
    }
    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

    window.addEventListener('mousemove', (e) => {
      applyTilt((0.5 - e.clientY / window.innerHeight) * 18, (e.clientX / window.innerWidth - 0.5) * 20);
    });
    window.addEventListener('touchmove', (e) => {
      const tch = e.touches[0];
      if (tch) applyTilt((0.5 - tch.clientY / window.innerHeight) * 14, (tch.clientX / window.innerWidth - 0.5) * 16);
    }, { passive: true });
    window.addEventListener('deviceorientation', (e) => {
      if (e.beta == null || e.gamma == null) return;
      applyTilt(clamp((45 - e.beta) * 0.35, -12, 12), clamp(e.gamma * 0.45, -14, 14));
    });

    const nameInput = document.getElementById('name-input');
    try { nameInput.value = localStorage.getItem('lonely_name') || ''; } catch (e) {}

    function beginExperience() {
      const raw = (nameInput.value || '').replace(/[<>&"{}|\\]/g, '').trim().slice(0, 18);
      USER.name = raw;
      USER.nameUp = raw.toLocaleUpperCase('pl-PL');
      try { localStorage.setItem('lonely_name', raw); } catch (e) {}
      nameInput.blur();

      audio.init();
      unlockMobileAudio();
      requestWakeLock();
      try {
        if (navigator.getBattery) navigator.getBattery().then((b) => { BATTERY = Math.round(b.level * 100); }).catch(() => {});
      } catch (e) {}
      try {
        if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
          DeviceOrientationEvent.requestPermission().catch(() => {});
        }
      } catch (e) {}
      if (isMobile && document.documentElement.requestFullscreen && !document.fullscreenElement) {
        document.documentElement.requestFullscreen({ navigationUI: 'hide' }).catch(() => {});
      }
      haptic(30);
      const overlay = document.getElementById('start-overlay');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      startFilm(pickRandomFilm());
    }

    document.getElementById('start-experience-btn').addEventListener('click', beginExperience);
    nameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') beginExperience(); });

    document.getElementById('reroll-btn').addEventListener('click', () => {
      audio.init();
      audio.playGlitchNoise(0.2);
      audio.whoosh(0.5, 0.22);
      startFilm(pickRandomFilm());
    });

    document.getElementById('replay-btn').addEventListener('click', () => {
      audio.init();
      if (activeFilm) startFilm(activeFilm);
    });

    themePicker.addEventListener('change', (e) => {
      audio.init();
      const id = parseInt(e.target.value, 10);
      const found = FILMS.find((f) => f.id === id);
      if (found) startFilm(found);
    });

    document.getElementById('mute-btn').addEventListener('click', (e) => {
      const muted = audio.toggleMute();
      e.currentTarget.textContent = muted ? '🔇' : '🔊';
      if (muted && navigator.vibrate) { try { navigator.vibrate(0); } catch (err) {} }
    });
  </script>
</body>
</html>
