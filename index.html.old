<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#050507" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>Każdy może znaleźć miłość... (oprócz ciebie)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800;900&family=JetBrains+Mono:wght@400;700;800&family=Caveat:wght@600;700&family=Bangers&family=Playfair+Display:ital,wght@0,600;0,800;1,400;1,700&family=VT323&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #050507;
      --fg: #f4f4f6;
      --accent: #ff003c;
    }
    * { box-sizing: border-box; user-select: none; -webkit-font-smoothing: antialiased; }
    body, html {
      margin: 0; padding: 0;
      width: 100%; height: 100%;
      background-color: var(--bg);
      color: var(--fg);
      font-family: 'Inter', sans-serif;
      overflow: hidden;
    }

    .font-mono-code { font-family: 'JetBrains Mono', monospace; }
    .font-hand { font-family: 'Caveat', cursive; }
    .font-comic { font-family: 'Bangers', cursive; letter-spacing: 2px; }
    .font-serif-italic { font-family: 'Playfair Display', serif; }
    .font-vhs { font-family: 'VT323', monospace; }

    @keyframes hard-shake {
      0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
      10% { transform: translate(-14px, -10px) rotate(-2deg) scale(1.04); }
      20% { transform: translate(14px, 8px) rotate(2deg) scale(0.97); }
      30% { transform: translate(-12px, 10px) rotate(-1.5deg) scale(1.03); }
      40% { transform: translate(10px, -8px) rotate(1.2deg) scale(1.01); }
      50% { transform: translate(-8px, 6px) rotate(-0.8deg) scale(1); }
      70% { transform: translate(5px, -4px) rotate(0.6deg) scale(1.01); }
    }
    .shake-screen {
      animation: hard-shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }

    @keyframes beat-thump {
      0% { transform: scale(1.08); filter: brightness(1.4) contrast(1.2); }
      100% { transform: scale(1); filter: brightness(1) contrast(1); }
    }
    .beat-pulse {
      animation: beat-thump 0.38s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes slam-in {
      0% { transform: scale(2.6); opacity: 0; filter: blur(10px); }
      60% { transform: scale(0.93); opacity: 1; filter: blur(0px); }
      100% { transform: scale(1); opacity: 1; }
    }
    .slam-anim {
      animation: slam-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes rgb-glitch {
      0% { text-shadow: -6px 0 #ff0040, 6px 0 #00f0ff; transform: translate(0, 0) skewX(0deg); }
      20% { text-shadow: 8px 0 #ff0040, -8px 0 #00f0ff; transform: translate(-5px, 3px) skewX(-5deg); }
      40% { text-shadow: -5px 0 #ff0040, 5px 0 #00f0ff; transform: translate(5px, -3px) skewX(5deg); }
      60% { text-shadow: 10px 0 #ff0040, -10px 0 #00f0ff; transform: translate(-4px, -2px) skewX(0deg); }
      80% { text-shadow: -8px 0 #ff0040, 8px 0 #00f0ff; transform: translate(4px, 3px) skewX(-3deg); }
      100% { text-shadow: 5px 0 #ff0040, -5px 0 #00f0ff; transform: translate(0, 0) skewX(0deg); }
    }
    .glitch-heavy {
      animation: rgb-glitch 0.2s infinite;
    }

    .chat-3d-wrapper {
      perspective: 1400px;
      transform-style: preserve-3d;
    }
    .chat-3d-plane {
      transform: rotateX(14deg) rotateY(-16deg) rotateZ(2.5deg) scale(1.03);
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.7s ease;
      transform-style: preserve-3d;
      box-shadow: -30px 40px 100px rgba(0, 0, 0, 0.95), 0 0 60px rgba(239, 68, 68, 0.1);
    }
    .chat-3d-plane.twist-zoom {
      transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(1.15) translateZ(80px);
    }

    .scene-3d-viewport {
      perspective: 1600px;
      transform-style: preserve-3d;
    }
    .scene-3d-card {
      transform-style: preserve-3d;
      transform: rotateX(calc(var(--rx, 0deg) + 5deg)) rotateY(calc(var(--ry, 0deg) - 5deg)) translateZ(25px);
      transition: transform 0.22s ease-out;
      animation: cinema-float-3d 3.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .depth-layer-front {
      transform: translateZ(65px);
      text-shadow: 0 20px 40px rgba(0, 0, 0, 0.9);
    }
    .depth-layer-mid {
      transform: translateZ(35px);
    }
    .depth-layer-glow {
      transform: translateZ(-40px) scale(1.2);
      filter: blur(32px);
    }
    @keyframes cinema-float-3d {
      0% {
        opacity: 0;
        filter: blur(14px);
        transform: perspective(1600px) translateZ(-300px) rotateX(20deg) rotateY(-14deg) scale(0.8);
      }
      15% {
        opacity: 1;
        filter: blur(0px);
        transform: perspective(1600px) translateZ(20px) rotateX(calc(var(--rx, 0deg) + 4deg)) rotateY(calc(var(--ry, 0deg) - 4deg)) scale(1);
      }
      88% {
        opacity: 1;
        filter: blur(0px);
        transform: perspective(1600px) translateZ(55px) rotateX(calc(var(--rx, 0deg) - 2deg)) rotateY(calc(var(--ry, 0deg) + 3deg)) scale(1.04);
      }
      100% {
        opacity: 0.96;
        transform: perspective(1600px) translateZ(70px) rotateX(0deg) rotateY(0deg) scale(1.06);
      }
    }

    @keyframes crt-off {
      0% { transform: scale(1, 1); filter: brightness(1); opacity: 1; }
      35% { transform: scale(1.12, 0.006); filter: brightness(7); opacity: 1; }
      75% { transform: scale(0.01, 0.006); filter: brightness(12); opacity: 1; }
      100% { transform: scale(0, 0); filter: brightness(0); opacity: 0; }
    }
    .crt-collapse {
      animation: crt-off 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    }

    .vignette-layer {
      background: radial-gradient(circle at center, transparent 35%, rgba(0, 0, 0, 0.9) 100%);
    }
    .vhs-scanlines {
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.5) 50%),
                  linear-gradient(90deg, rgba(255,0,0,0.06), rgba(0,255,0,0.02), rgba(0,0,255,0.06));
      background-size: 100% 4px, 6px 100%;
    }
    .synth-grid-3d {
      background-size: 50px 50px;
      background-image: 
        linear-gradient(to right, rgba(236, 72, 153, 0.4) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(236, 72, 153, 0.4) 1px, transparent 1px);
      transform: perspective(280px) rotateX(65deg);
      transform-origin: center top;
      animation: grid-move 1.8s linear infinite;
    }
    @keyframes grid-move {
      from { background-position: 0 0; }
      to { background-position: 0 50px; }
    }
    .comic-rays {
      background-color: #facc15;
      background-image: radial-gradient(#ca8a04 24%, transparent 24%);
      background-size: 20px 20px;
    }
    .notebook-lines {
      background-color: #f8f4e8;
      background-image: linear-gradient(#93c5fd 1px, transparent 1px);
      background-size: 100% 36px;
      color: #111827;
    }
    .led-dots {
      background-color: #070709;
      background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1.5px, transparent 1.5px);
      background-size: 8px 8px;
    }
    .win95-window {
      background: #c0c0c0;
      border-top: 3px solid #ffffff;
      border-left: 3px solid #ffffff;
      border-right: 3px solid #222222;
      border-bottom: 3px solid #222222;
      box-shadow: 10px 10px 0px rgba(0, 0, 0, 0.7);
      color: #000;
    }
    @keyframes radar-sweep-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .radar-beam {
      background: conic-gradient(from 0deg, transparent 65%, rgba(255, 0, 60, 0.7) 100%);
      animation: radar-sweep-spin 1.6s linear infinite;
    }
    @keyframes spin-slow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .spin-spiral {
      animation: spin-slow 8s linear infinite;
    }
    @keyframes dot-bounce {
      0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
      40% { opacity: 1; transform: translateY(-5px); }
    }
    .t-dot-1 { animation: dot-bounce 1.1s infinite 0s; }
    .t-dot-2 { animation: dot-bounce 1.1s infinite 0.16s; }
    .t-dot-3 { animation: dot-bounce 1.1s infinite 0.32s; }

    /* ===================== NOWE EFEKTY EMOCJONALNE 3D ===================== */
    #pulse-layer {
      position: fixed; inset: 0; pointer-events: none; z-index: 11; opacity: 0;
      background: radial-gradient(circle at center, transparent 40%, rgba(255, 0, 60, 0.6) 100%);
    }
    #pulse-layer.pulse-beat { animation: pulse-beat 0.6s ease-out; }
    @keyframes pulse-beat {
      0% { opacity: 0; }
      10% { opacity: var(--pulse-strength, 0.35); }
      22% { opacity: calc(var(--pulse-strength, 0.35) * 0.35); }
      32% { opacity: calc(var(--pulse-strength, 0.35) * 0.8); }
      100% { opacity: 0; }
    }

    #dim-layer {
      position: fixed; inset: 0; pointer-events: none; z-index: 15; background: #000;
      opacity: 0; transition: opacity 1.6s ease;
    }
    #dim-layer.on { opacity: 0.7; }

    /* Tunel z serc lecących w stronę widza */
    .tunnel {
      position: fixed; inset: 0; perspective: 500px; pointer-events: none; z-index: 12;
      display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.5s;
      transform-style: preserve-3d;
    }
    .tunnel.on { opacity: 1; }
    .tunnel-ring {
      position: absolute; width: 70vmin; height: 70vmin;
      animation: tunnel-fly 2.2s linear infinite;
      filter: drop-shadow(0 0 12px rgba(255, 0, 60, 0.8));
    }
    .tunnel-ring svg { width: 100%; height: 100%; overflow: visible; }
    @keyframes tunnel-fly {
      0% { transform: translateZ(-2400px) rotateZ(0deg); opacity: 0; }
      15% { opacity: 1; }
      100% { transform: translateZ(460px) rotateZ(25deg); opacity: 0; }
    }

    /* Pękające serce 3D */
    .heartbreak-stage {
      position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
      perspective: 900px; pointer-events: none; z-index: 35;
    }
    .heart-wrap {
      position: relative; width: min(62vw, 360px); aspect-ratio: 32 / 29.6;
      transform-style: preserve-3d;
      animation: heart-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .heart-wrap.big { width: min(80vw, 480px); }
    .heart-half { position: absolute; inset: 0; }
    .heart-glow {
      position: absolute; inset: -35%; border-radius: 50%; pointer-events: none;
      background: radial-gradient(circle, rgba(255, 0, 60, 0.6) 0%, rgba(255, 0, 60, 0.25) 35%, transparent 65%);
      animation: heart-glow-out 1.6s ease-out forwards;
    }
    @keyframes heart-glow-out { 0%, 25% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.6); } }
    .heart-half svg { width: 100%; height: 100%; display: block; }
    .heart-half.left {
      clip-path: polygon(0 0, 50% 0, 50% 19%, 45% 34%, 55% 50%, 44% 66%, 53% 82%, 50% 100%, 0 100%);
      animation: half-left 1.9s cubic-bezier(0.5, 0, 0.75, 0) forwards;
    }
    .heart-half.right {
      clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%, 53% 82%, 44% 66%, 55% 50%, 45% 34%, 50% 19%);
      animation: half-right 1.9s cubic-bezier(0.5, 0, 0.75, 0) forwards;
    }
    @keyframes heart-in {
      0% { transform: scale(0.2) translateZ(-300px); opacity: 0; }
      45% { transform: scale(1.2); opacity: 1; }
      65% { transform: scale(0.95); }
      100% { transform: scale(1); opacity: 1; }
    }
    @keyframes half-left {
      0%, 20% { transform: translate3d(0, 0, 0) rotateY(0deg) rotateZ(0deg); opacity: 1; }
      32% { transform: translate3d(-16px, 6px, 40px) rotateY(-14deg) rotateZ(-7deg); opacity: 1; }
      100% { transform: translate3d(-50vw, 75vh, -400px) rotateY(-88deg) rotateZ(-58deg); opacity: 0; }
    }
    @keyframes half-right {
      0%, 20% { transform: translate3d(0, 0, 0) rotateY(0deg) rotateZ(0deg); opacity: 1; }
      32% { transform: translate3d(16px, 6px, 40px) rotateY(14deg) rotateZ(7deg); opacity: 1; }
      100% { transform: translate3d(50vw, 75vh, -400px) rotateY(88deg) rotateZ(58deg); opacity: 0; }
    }
    .crack-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .crack-svg polyline {
      fill: none; stroke: #fff; stroke-width: 4; vector-effect: non-scaling-stroke;
      stroke-linejoin: round; stroke-dasharray: 100; stroke-dashoffset: 100;
      filter: drop-shadow(0 0 8px #fff);
      animation: crack-draw 0.2s 0.12s ease-out forwards, crack-fade 0.35s 0.45s forwards;
    }
    @keyframes crack-draw { to { stroke-dashoffset: 0; } }
    @keyframes crack-fade { to { opacity: 0; } }

    /* Pęknięty ekran telefonu */
    .screen-crack { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 30; }
    .screen-crack polyline {
      fill: none; stroke: rgba(255, 255, 255, 0.85); stroke-width: 1.4; vector-effect: non-scaling-stroke;
      stroke-dasharray: 100; stroke-dashoffset: 100;
      filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.9));
      animation: crack-draw 0.35s ease-out forwards;
    }

    /* Napięcie przed ciosem */
    .chat-3d-plane.tension-push {
      transform: rotateX(4deg) rotateY(-5deg) rotateZ(1deg) scale(1.1) translateZ(40px);
      transition: transform 3.2s cubic-bezier(0.4, 0, 0.2, 1), filter 3s ease;
      filter: saturate(0.6) brightness(0.85);
    }
    .chat-3d-plane.twist-zoom { filter: none; }

    /* Litery wlatujące w 3D */
    .letters-3d { display: inline; }
    .word-3d { display: inline-block; white-space: nowrap; perspective: 520px; }
    .letter-3d {
      display: inline-block; opacity: 0;
      animation: letter-drop 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes letter-drop {
      0% { opacity: 0; transform: translate3d(0, -40px, 520px) rotateX(-110deg) rotateY(35deg); filter: blur(10px); }
      60% { opacity: 1; filter: blur(0); }
      100% { opacity: 1; transform: translate3d(0, 0, 0) rotateX(0) rotateY(0); }
    }
    .twist-bubble {
      animation: twist-pop 0.55s cubic-bezier(0.16, 1, 0.3, 1) both, twist-glow 1.6s ease-in-out 0.6s infinite;
      box-shadow: 0 0 80px #dc2626;
    }
    .twist-bubble .letters-3d { animation: rgb-text 0.22s infinite; }
    @keyframes twist-pop {
      0% { transform: perspective(700px) translateZ(-400px) rotateX(50deg) scale(0.6); opacity: 0; }
      100% { transform: perspective(700px) translateZ(0) rotateX(0) scale(1); opacity: 1; }
    }
    @keyframes twist-glow {
      0%, 100% { box-shadow: 0 0 60px #dc2626, 0 0 0 0 rgba(255, 0, 60, 0.5); }
      50% { box-shadow: 0 0 120px #ff003c, 0 0 0 14px rgba(255, 0, 60, 0); }
    }
    @keyframes rgb-text {
      0% { text-shadow: -3px 0 #00f0ff, 3px 0 #ff9eb5; }
      50% { text-shadow: 4px 0 #00f0ff, -4px 0 #ff9eb5; }
      100% { text-shadow: -2px 0 #00f0ff, 2px 0 #ff9eb5; }
    }

    /* Rozszczepienie RGB całej sceny */
    .chroma-split { animation: chroma 0.9s ease-out; }
    @keyframes chroma {
      0% { filter: drop-shadow(12px 0 0 rgba(255, 0, 60, 0.85)) drop-shadow(-12px 0 0 rgba(0, 240, 255, 0.75)); }
      40% { filter: drop-shadow(-7px 3px 0 rgba(255, 0, 60, 0.7)) drop-shadow(7px -3px 0 rgba(0, 240, 255, 0.6)); }
      100% { filter: drop-shadow(0 0 0 rgba(255, 0, 60, 0)) drop-shadow(0 0 0 rgba(0, 240, 255, 0)); }
    }

    /* Kinowe wejścia i wyjścia scen w 3D */
    .scene-3d-card.enter-var { animation: scene-enter-var 3.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes scene-enter-var {
      0% {
        opacity: 0; filter: blur(16px);
        transform: perspective(1600px) translate3d(var(--ex, 0px), var(--ey, 0px), -700px)
                   rotateX(var(--erx, 20deg)) rotateY(var(--ery, -20deg)) rotateZ(var(--erz, 0deg)) scale(0.7);
      }
      16% {
        opacity: 1; filter: blur(0px);
        transform: perspective(1600px) translateZ(20px) rotateX(calc(var(--rx, 0deg) + 4deg)) rotateY(calc(var(--ry, 0deg) - 4deg)) scale(1);
      }
      100% {
        opacity: 1; filter: blur(0px);
        transform: perspective(1600px) translateZ(70px) rotateX(calc(var(--rx, 0deg) * 0.5)) rotateY(calc(var(--ry, 0deg) * 0.5)) scale(1.06);
      }
    }
    .scene-exit { animation: scene-exit 0.45s cubic-bezier(0.7, 0, 0.84, 0) forwards !important; }
    @keyframes scene-exit {
      to {
        opacity: 0; filter: blur(14px);
        transform: perspective(1600px) translateZ(-520px) rotateY(var(--xry, 60deg)) rotateX(var(--xrx, -12deg)) scale(0.8);
      }
    }
    .depth-layer-back {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      transform: translateZ(-140px) scale(1.4); font-size: 16rem; opacity: 0.07; filter: blur(3px);
      pointer-events: none; animation: back-breathe 3.2s ease-in-out infinite;
    }
    @keyframes back-breathe {
      0%, 100% { transform: translateZ(-140px) scale(1.4); }
      50% { transform: translateZ(-110px) scale(1.5); }
    }

    /* Wyciągnięty w 3D napis finałowy */
    .extrude-wrap { perspective: 900px; display: inline-block; }
    .extrude-enter { display: inline-block; transform-style: preserve-3d; animation: extrude-enter 1.3s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .extrude { position: relative; display: inline-block; transform-style: preserve-3d; animation: extrude-swing 5s ease-in-out 1.3s infinite alternate; }
    .ex-layer {
      position: absolute; left: 0; top: 0; width: 100%; height: 100%;
      opacity: 0; text-shadow: none; pointer-events: none;
      animation: ex-fade 0.6s ease-out 1s forwards;
    }
    .ex-front { position: relative; display: inline-block; color: #ff1744; animation: ex-glow 2.4s ease-in-out infinite; }
    @keyframes extrude-enter {
      0% { opacity: 0; transform: translateZ(-900px) rotateX(60deg); }
      100% { opacity: 1; transform: none; }
    }
    @keyframes extrude-swing {
      0% { transform: rotateY(-22deg) rotateX(10deg); }
      100% { transform: rotateY(22deg) rotateX(-6deg); }
    }
    @keyframes ex-fade { to { opacity: 1; } }
    @keyframes ex-glow {
      0%, 100% { text-shadow: 0 0 25px rgba(255, 0, 60, 0.6), -3px 0 rgba(0, 240, 255, 0.45), 3px 0 rgba(255, 0, 60, 0.6); }
      50% { text-shadow: 0 0 70px rgba(255, 0, 60, 1), -6px 0 rgba(0, 240, 255, 0.6), 6px 0 rgba(255, 0, 60, 0.85); }
    }

    /* Interludium – migający kursor */
    .ilx-caret { animation: caret 1s steps(1) infinite; color: #3b82f6; font-weight: 300; }
    @keyframes caret { 50% { opacity: 0; } }

    .finale-figure { animation: figure-sink 4s ease-in-out infinite; display: inline-block; }
    @keyframes figure-sink {
      0%, 100% { transform: translateY(0) rotateZ(0deg); }
      50% { transform: translateY(6px) rotateZ(-2deg); }
    }

    /* ===================== WERSJA 3: TELEFONY + GŁĘBSZE EMOCJE ===================== */
    html, body {
      height: 100%;
      height: 100dvh;
      overscroll-behavior: none;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      -webkit-text-size-adjust: 100%;
    }
    input, textarea { user-select: text; -webkit-user-select: text; }
    .hud-safe {
      padding-top: max(14px, env(safe-area-inset-top));
      padding-bottom: max(14px, calc(env(safe-area-inset-bottom) + 8px));
      padding-left: max(12px, env(safe-area-inset-left));
      padding-right: max(12px, env(safe-area-inset-right));
    }
    #cinematic-stage {
      padding-top: calc(env(safe-area-inset-top) + 64px);
      padding-bottom: calc(env(safe-area-inset-bottom) + 64px);
    }

    /* Ziarno filmowe */
    #grain {
      position: fixed; inset: -50%; z-index: 28; pointer-events: none; opacity: 0.08;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
      animation: grain 0.6s steps(5) infinite;
      mix-blend-mode: overlay;
    }
    @keyframes grain {
      0% { transform: translate(0, 0); }
      20% { transform: translate(-6%, 4%); }
      40% { transform: translate(5%, -7%); }
      60% { transform: translate(-3%, 8%); }
      80% { transform: translate(7%, 2%); }
      100% { transform: translate(0, 0); }
    }

    /* Świat traci kolory */
    #desat-layer {
      position: fixed; inset: 0; z-index: 27; pointer-events: none;
      background: #808080; mix-blend-mode: saturation;
      opacity: 0; transition: opacity 2.5s ease;
    }
    #desat-layer.instant { transition: opacity 0.05s; }

    /* Kinowe pasy */
    .letterbox {
      position: fixed; left: 0; right: 0; height: 0; background: #000; z-index: 29; pointer-events: none;
      transition: height 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #lb-top { top: 0; }
    #lb-bottom { bottom: 0; }
    body.letterbox-on #lb-top, body.letterbox-on #lb-bottom { height: 11dvh; }

    /* Zwolnione tempo przed ciosem */
    body.slowmo .t-dot-1, body.slowmo .t-dot-2, body.slowmo .t-dot-3 { animation-duration: 2.8s; }
    body.slowmo #pulse-layer.pulse-beat { animation-duration: 1.1s; }

    /* Oddychający ekran */
    body.breathe #cinematic-stage { animation: breathe 5.5s ease-in-out infinite; }
    @keyframes breathe {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.025); }
    }

    /* Ciepła poświata nadziei */
    .hope-glow { box-shadow: 0 0 0 1px rgba(251, 191, 36, 0.4), 0 0 70px rgba(251, 191, 36, 0.35), -30px 40px 100px rgba(0, 0, 0, 0.95) !important; transition: box-shadow 1.2s ease; }
    .hope-bubble { box-shadow: 0 0 24px rgba(251, 191, 36, 0.55); }

    /* Fałszywe powiadomienie */
    .notif {
      position: fixed; left: 50%; top: calc(env(safe-area-inset-top) + 10px); z-index: 45;
      width: min(92vw, 380px); display: flex; gap: 10px; align-items: flex-start;
      padding: 12px 14px; border-radius: 20px;
      background: rgba(38, 38, 44, 0.86); color: #fff;
      backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
      transform: translate(-50%, -160%) perspective(600px) rotateX(-50deg);
      opacity: 0; pointer-events: none;
      transition: transform 0.6s cubic-bezier(0.16, 1.3, 0.3, 1), opacity 0.4s;
      font-family: 'Inter', sans-serif; text-transform: none; letter-spacing: 0;
    }
    .notif.show { transform: translate(-50%, 0) perspective(600px) rotateX(0deg); opacity: 1; }
    .notif-icon { width: 38px; height: 38px; border-radius: 10px; background: linear-gradient(135deg, #ff4d6d, #c9184a); display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
    .notif-app { font-size: 11px; opacity: 0.6; font-weight: 600; letter-spacing: 0.04em; }
    .notif-title { font-size: 14px; font-weight: 700; margin-top: 1px; }
    .notif-body { font-size: 13px; opacity: 0.85; margin-top: 1px; }
    .notif-time { font-size: 11px; opacity: 0.5; margin-left: auto; flex-shrink: 0; }
    .notif.sad .notif-icon { background: #3f3f46; filter: grayscale(1); }
    .notif.sad .notif-title { color: #a1a1aa; }
    .notif .swap { animation: notif-swap 0.5s ease; }
    @keyframes notif-swap { 0% { opacity: 0; transform: translateY(6px); } 100% { opacity: 1; transform: none; } }

    /* Polaroidy z wymyślonymi wspomnieniami */
    .polaroid-stage { position: relative; width: 100%; height: min(58dvh, 460px); perspective: 900px; }
    .polaroid {
      position: absolute; left: 50%; top: 50%; width: min(40vw, 170px);
      background: #f6f2e9; padding: 8px 8px 30px; color: #2a2a2a;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.6);
      opacity: 0; transform-style: preserve-3d;
      animation: polaroid-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      transition: filter 1.4s ease;
    }
    .polaroid .ph {
      aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 2.6rem;
      background: linear-gradient(135deg, #ffd6a5, #ffadad 55%, #f8c4e3);
    }
    .polaroid .cap { font-family: 'Caveat', cursive; font-size: 1.2rem; text-align: center; margin-top: 6px; line-height: 1.1; }
    .polaroid.faded { filter: grayscale(1) brightness(0.6) contrast(0.9); }
    .polaroid.fall { animation: polaroid-fall 1.8s cubic-bezier(0.55, 0, 1, 0.45) forwards; }
    @keyframes polaroid-in {
      0% { opacity: 0; transform: translate(-50%, -50%) translate3d(var(--px), var(--py), 600px) rotateX(70deg) rotateZ(calc(var(--pr) * -3)); }
      100% { opacity: 1; transform: translate(-50%, -50%) translate3d(var(--px), var(--py), 0) rotateZ(var(--pr)); }
    }
    @keyframes polaroid-fall {
      0% { opacity: 1; transform: translate(-50%, -50%) translate3d(var(--px), var(--py), 0) rotateZ(var(--pr)); }
      100% { opacity: 0; transform: translate(-50%, -50%) translate3d(var(--px), calc(var(--py) + 80dvh), -300px) rotateX(60deg) rotateZ(calc(var(--pr) * 6)); }
    }

    /* Łzy na „obiektywie” */
    .lens-drop {
      position: fixed; z-index: 29; pointer-events: none;
      width: var(--s); height: calc(var(--s) * 1.3);
      border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
      background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.1) 45%, rgba(255, 255, 255, 0) 70%);
      box-shadow: inset -2px -3px 6px rgba(255, 255, 255, 0.25), 0 2px 6px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
      animation: lens-slide var(--d) ease-in forwards;
    }
    @keyframes lens-slide {
      0% { opacity: 0; transform: translateY(0) scale(0.5); }
      12% { opacity: 0.9; transform: translateY(0) scale(1); }
      45% { transform: translateY(5dvh) scale(1); }
      100% { opacity: 0; transform: translateY(70dvh) scale(0.9, 1.3); }
    }

    /* Czwarta ściana */
    .fourth-wall { font-family: 'Playfair Display', serif; font-style: italic; }
    .fourth-wall .line { opacity: 0; animation: fw-in 1.6s ease forwards; }
    @keyframes fw-in { 0% { opacity: 0; filter: blur(8px); transform: translateY(8px); } 100% { opacity: 1; filter: blur(0); transform: none; } }

    .ps-line { opacity: 0; transition: opacity 3s ease; }
    .ps-line.show { opacity: 0.75; }

    /* Ekran startowy */
    .start-input {
      background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15);
      color: #fff; border-radius: 999px; padding: 12px 18px; width: min(80vw, 300px);
      text-align: center; outline: none; font-size: 16px;
    }
    .start-input:focus { border-color: rgba(239, 68, 68, 0.8); box-shadow: 0 0 30px rgba(239, 68, 68, 0.35); }

    @media (max-width: 640px) {
      @keyframes scene-enter-var {
        0% {
          opacity: 0; filter: blur(14px);
          transform: perspective(1600px) translate3d(var(--ex, 0px), var(--ey, 0px), -600px)
                     rotateX(var(--erx, 20deg)) rotateY(var(--ery, -20deg)) rotateZ(var(--erz, 0deg)) scale(0.7);
        }
        16% {
          opacity: 1; filter: blur(0px);
          transform: perspective(1600px) translateZ(0px) rotateX(calc(var(--rx, 0deg) + 3deg)) rotateY(calc(var(--ry, 0deg) - 3deg)) scale(0.96);
        }
        100% {
          opacity: 1; filter: blur(0px);
          transform: perspective(1600px) translateZ(10px) rotateX(calc(var(--rx, 0deg) * 0.4)) rotateY(calc(var(--ry, 0deg) * 0.4)) scale(0.98);
        }
      }
      .depth-layer-front { transform: translateZ(18px); }
      .depth-layer-mid { transform: translateZ(10px); }
      .polaroid { width: 34vw; padding: 6px 6px 24px; }
      .polaroid .ph { font-size: 2rem; }
      .polaroid .cap { font-size: 1rem; }
      .depth-layer-back { font-size: 10rem; }
      .depth-layer-front { text-shadow: 0 10px 25px rgba(0, 0, 0, 0.9); }
      .twist-bubble { font-size: 1.7rem; padding: 1rem 1.4rem; }
      .tunnel-ring { width: 85vmin; height: 85vmin; }
    }
    @media (prefers-reduced-motion: reduce) {
      .shake-screen { animation: none; }
      #grain { animation: none; }
    }
  </style>
</head>
<body class="relative w-full h-full overflow-hidden select-none bg-[#050507]">

  <canvas id="bg-canvas" class="fixed inset-0 pointer-events-none z-0"></canvas>
  <div id="theme-bg-layer" class="fixed inset-0 pointer-events-none z-0 transition-all duration-300"></div>
  <div class="fixed inset-0 pointer-events-none z-10 vignette-layer"></div>
  <div id="flash-overlay" class="fixed inset-0 pointer-events-none z-40 bg-red-600 opacity-0 transition-opacity duration-150"></div>
  <div id="pulse-layer"></div>
  <div id="dim-layer"></div>
  <div id="tunnel-layer" class="tunnel"></div>
  <canvas id="fx-canvas" class="fixed inset-0 pointer-events-none" style="z-index:26"></canvas>
  <div id="heartbreak-layer" class="heartbreak-stage"></div>

  <div id="start-overlay" class="fixed inset-0 z-50 bg-black flex flex-col items-center justify-center p-6 text-center transition-opacity duration-700 overflow-y-auto hud-safe">
    <div class="relative mb-6 sm:mb-8 flex items-center justify-center">
      <div class="absolute w-32 h-32 rounded-full bg-red-600/25 animate-ping"></div>
      <div class="w-24 h-24 rounded-full border border-white/20 bg-zinc-950 flex items-center justify-center shadow-[0_0_60px_rgba(239,68,68,0.5)]">
        <span class="text-4xl">💔</span>
      </div>
    </div>
    <div class="font-mono-code text-[10px] sm:text-[11px] uppercase tracking-[0.3em] text-red-500 mb-3">
      KINOWE DOŚWIADCZENIE • 17 HISTORII
    </div>
    <h1 class="text-4xl sm:text-6xl font-black tracking-tighter text-white mb-3 sm:mb-4">
      „Każdy może znaleźć miłość”
    </h1>
    <p class="text-lg sm:text-2xl font-serif-italic text-red-500 glitch-heavy mb-6 sm:mb-8">
      (oprócz ciebie)
    </p>
    <label for="name-input" class="text-xs text-zinc-400 mb-2">Jak masz na imię? <span class="opacity-60">(opcjonalnie — historia będzie o tobie)</span></label>
    <input id="name-input" class="start-input mb-6" maxlength="18" autocomplete="off" autocapitalize="words" placeholder="twoje imię" />
    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-[11px] text-zinc-500 mb-6 max-w-sm">
      <span>🎧 załóż słuchawki</span>
      <span>🔕 wyłącz tryb cichy</span>
      <span>📱 trzymaj telefon pionowo</span>
      <span>🌙 najlepiej w nocy, po ciemku</span>
    </div>
    <button id="start-experience-btn" class="group relative px-8 sm:px-10 py-4 rounded-full bg-white text-black font-black text-xs sm:text-sm uppercase tracking-widest hover:bg-red-600 hover:text-white transition-all duration-300 shadow-[0_0_50px_rgba(255,255,255,0.3)] hover:shadow-[0_0_70px_rgba(239,68,68,0.9)] hover:scale-105 active:scale-95">
      ▶ ZACZNIJ (WŁĄCZ DŹWIĘK)
    </button>
  </div>

  <div class="fixed inset-0 pointer-events-none z-30 hud-safe flex flex-col justify-between font-mono-code text-[10px] sm:text-[11px] tracking-widest uppercase">
    <div class="flex items-start justify-between gap-2">
      <div class="flex items-center gap-2 pointer-events-auto bg-black/50 backdrop-blur-md px-2.5 sm:px-3 py-1.5 rounded-lg border border-white/10 min-w-0">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-ping shrink-0"></span>
        <span id="hud-top-left" class="text-white font-bold hidden sm:inline">REC 00:00:00</span>
        <span class="text-zinc-600 hidden sm:inline">|</span>
        <select id="theme-picker" class="bg-transparent text-zinc-300 outline-none cursor-pointer hover:text-white max-w-[42vw] sm:max-w-xs truncate">
          <!-- Populated by JS -->
        </select>
      </div>

      <div class="flex items-center gap-2 pointer-events-auto shrink-0">
        <button id="reroll-btn" class="px-3 py-1.5 rounded-lg bg-red-600/25 border border-red-500/50 text-red-200 hover:bg-red-600 hover:text-white transition font-bold flex items-center gap-1.5 shadow-lg" aria-label="Losuj inny film">
          <span>🎲</span> <span class="hidden sm:inline">LOSUJ INNY FILM</span>
        </button>
        <button id="mute-btn" class="px-2.5 py-1.5 rounded-lg bg-black/50 backdrop-blur-md border border-white/10 text-zinc-300 hover:text-white transition" aria-label="Wycisz">
          🔊
        </button>
      </div>
    </div>

    <!-- Viewfinder Corner Brackets -->
    <div class="hidden sm:block fixed top-16 left-6 w-5 h-5 border-t-2 border-l-2 border-white/30 pointer-events-none"></div>
    <div class="hidden sm:block fixed top-16 right-6 w-5 h-5 border-t-2 border-r-2 border-white/30 pointer-events-none"></div>
    <div class="hidden sm:block fixed bottom-14 left-6 w-5 h-5 border-b-2 border-l-2 border-white/30 pointer-events-none"></div>
    <div class="hidden sm:block fixed bottom-14 right-6 w-5 h-5 border-b-2 border-r-2 border-white/30 pointer-events-none"></div>

    <div class="flex items-end justify-between gap-2">
      <div class="bg-black/50 backdrop-blur-md px-2.5 sm:px-3 py-1.5 rounded-lg border border-white/10 text-zinc-400 min-w-0 truncate">
        <span id="hud-bottom-left">*OBOWIĄZUJĄ WARUNKI • DOPASOWAŃ: 0</span>
      </div>
      <div class="flex items-center gap-2 pointer-events-auto shrink-0">
        <div class="hidden sm:block bg-black/50 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/10 text-zinc-400">
          <span id="hud-bottom-right">SCENA 01/12</span>
        </div>
        <button id="replay-btn" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white border border-white/15 transition" aria-label="Powtórz">
          ↻<span class="hidden sm:inline"> POWTÓRZ</span>
        </button>
      </div>
    </div>
  </div>

  <div class="fixed bottom-0 left-0 right-0 h-1 bg-white/10 z-40">
    <div id="timeline-bar" class="h-full bg-red-600 transition-all duration-300 w-0 shadow-[0_0_15px_#ef4444]"></div>
  </div>

  <div id="grain"></div>
  <div id="desat-layer"></div>
  <div id="lb-top" class="letterbox"></div>
  <div id="lb-bottom" class="letterbox"></div>
  <div id="notif" class="notif" aria-live="polite">
    <div class="notif-icon" id="notif-icon">💬</div>
    <div class="flex-1 min-w-0" id="notif-text">
      <div class="notif-app" id="notif-app"></div>
      <div class="notif-title" id="notif-title"></div>
      <div class="notif-body" id="notif-body"></div>
    </div>
    <div class="notif-time">teraz</div>
  </div>
  <div id="lens-layer"></div>

<main id="cinematic-stage" class="scene-3d-viewport relative z-20 w-full h-full flex items-center justify-center p-4 sm:p-8 overflow-hidden">
    <!-- Dynamic high-impact scenes injected here -->
  </main>

  <script>
    /*************************************************************************
     * EMOCJONALNY SILNIK AUDIO – generowana na żywo ścieżka filmowa
     * F-moll: Fm – Db – Ab – Eb, fortepian + smyczki + chór + bębny + bicie serca
     *************************************************************************/
    class EmotionalAudioEngine {
      constructor() {
        this.ctx = null;
        this.muted = false;
        this.running = false;
        this.intensity = 0;          // -1 outro, 0 cicho, 1 narastanie, 2 pełna moc
        this.bpm = 64;
        this.step = 0;
        this.nextStepTime = 0;
        this.timer = null;
        this.heartOn = false;
        this.heartRate = 62;
        this.heartVol = 0.4;
        this.nextHeartTime = 0;
        this.heartMuteFrom = 0;
        this.heartMuteTo = 0;
        this.heartTimeout = null;
        this.onHeartbeat = null;
        this.progression = [
          { bass: 43.65, pad: [174.61, 207.65, 261.63, 349.23], arp: [349.23, 415.30, 523.25, 698.46], mel: [[523.25, 2], [466.16, 1], [415.30, 1]] },
          { bass: 34.65, pad: [138.59, 174.61, 207.65, 277.18], arp: [277.18, 349.23, 415.30, 554.37], mel: [[415.30, 2], [349.23, 2]] },
          { bass: 51.91, pad: [207.65, 261.63, 311.13, 415.30], arp: [311.13, 415.30, 523.25, 622.25], mel: [[311.13, 1], [349.23, 1], [415.30, 2]] },
          { bass: 38.89, pad: [155.56, 196.00, 233.08, 311.13], arp: [311.13, 392.00, 466.16, 622.25], mel: [[392.00, 3], [311.13, 1]] }
        ];
        this.arpPattern = [0, 1, 2, 1, 3, 2, 1, 2];
        this.baseProg = JSON.parse(JSON.stringify(this.progression));
        this.keyRatio = 1;
        this.ambToken = 0;
        this.ambTimers = [];
        this.amb = null;
        this.ambType = 'none';
      }

      /* ---------- tonacja, tempo ---------- */
      setKey(semi) {
        const r = Math.pow(2, semi / 12);
        this.keyRatio = r;
        this.progression = this.baseProg.map((ch) => ({
          bass: ch.bass * r,
          pad: ch.pad.map((f) => f * r),
          arp: ch.arp.map((f) => f * r),
          mel: ch.mel.map(([f, b]) => [f * r, b])
        }));
      }
      setBpm(b) {
        this.bpm = b;
        if (this.delay) this.delay.delayTime.setValueAtTime((60 / b) * 0.75, this.ctx.currentTime);
      }

      /* ---------- proste klocki dźwiękowe ---------- */
      tone(f, t, dur, o = {}) {
        const c = this.ctx;
        const { type = 'sine', vol = 0.1, attack = 0.005, f2 = null, bus = this.sfxBus, pan = 0, delay = false } = o;
        const osc = c.createOscillator();
        osc.type = type;
        osc.frequency.setValueAtTime(f, t);
        if (f2) osc.frequency.exponentialRampToValueAtTime(f2, t + dur);
        const g = c.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + Math.min(attack, dur * 0.9));
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        osc.connect(g);
        let node = g;
        if (pan && c.createStereoPanner) {
          const p = c.createStereoPanner();
          p.pan.value = pan;
          g.connect(p);
          node = p;
        }
        node.connect(bus);
        if (delay) node.connect(this.delay);
        osc.start(t);
        osc.stop(t + dur + 0.05);
      }
      flatTone(f, t, dur, vol, bus = this.sfxBus, type = 'sine') {
        const c = this.ctx;
        const osc = c.createOscillator();
        osc.type = type;
        osc.frequency.value = f;
        const g = c.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + 0.01);
        g.gain.setValueAtTime(vol, t + dur - 0.02);
        g.gain.linearRampToValueAtTime(0.0001, t + dur);
        osc.connect(g);
        g.connect(bus);
        osc.start(t);
        osc.stop(t + dur + 0.05);
      }
      nhit(t, dur, o = {}) {
        const c = this.ctx;
        const { type = 'bandpass', f = 1000, f2 = null, q = 1, vol = 0.2, attack = 0.002, bus = this.sfxBus, pan = 0 } = o;
        const n = this.noiseSrc(t, dur);
        const fl = c.createBiquadFilter();
        fl.type = type;
        fl.frequency.setValueAtTime(f, t);
        if (f2) fl.frequency.exponentialRampToValueAtTime(f2, t + dur);
        fl.Q.value = q;
        const g = c.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + Math.min(attack, dur * 0.9));
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        n.connect(fl);
        fl.connect(g);
        let node = g;
        if (pan && c.createStereoPanner) {
          const p = c.createStereoPanner();
          p.pan.value = pan;
          g.connect(p);
          node = p;
        }
        node.connect(bus);
      }
      crumple(t, n = 14) {
        for (let i = 0; i < n; i++) {
          this.nhit(t + Math.random() * 0.5, 0.03 + Math.random() * 0.04, { f: 2000 + Math.random() * 4000, q: 2, vol: 0.12 + Math.random() * 0.1, pan: Math.random() * 2 - 1 });
        }
      }
      breath(t) {
        this.nhit(t, 1.1, { f: 700, q: 0.5, vol: 0.08, attack: 0.6 });
        this.nhit(t + 1.2, 1.4, { f: 500, q: 0.5, vol: 0.06, attack: 0.15 });
      }
      carPass(t, vol = 0.15, bus = this.sfxBus) {
        const c = this.ctx;
        const n = this.noiseSrc(t, 2.8);
        const lp = c.createBiquadFilter();
        lp.type = 'lowpass';
        lp.frequency.setValueAtTime(400, t);
        lp.frequency.linearRampToValueAtTime(1400, t + 1.3);
        lp.frequency.linearRampToValueAtTime(350, t + 2.8);
        const g = c.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(vol, t + 1.3);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 2.8);
        n.connect(lp);
        lp.connect(g);
        let node = g;
        if (c.createStereoPanner) {
          const p = c.createStereoPanner();
          const d = Math.random() < 0.5 ? -1 : 1;
          p.pan.setValueAtTime(-d * 0.9, t);
          p.pan.linearRampToValueAtTime(d * 0.9, t + 2.8);
          g.connect(p);
          node = p;
        }
        node.connect(bus);
      }
      keyClickAt(t) {
        this.nhit(t, 0.035, { type: 'highpass', f: 3500, vol: 0.07 });
      }

      /* ---------- biblioteka efektów specjalnych ---------- */
      sfx(name, delay = 0) {
        if (!this.live()) return;
        const c = this.ctx, t = c.currentTime + 0.01 + delay / 1000;
        const P = this.progression, k = this.keyRatio, R = () => Math.random();
        switch (name) {
          case 'radar':
            [0, 1.1, 2.2].forEach((d, i) => {
              this.tone(1318.5 * k, t + d, 1.4, { vol: [0.09, 0.06, 0.035][i], delay: true });
              this.tone(2637 * k, t + d, 0.4, { vol: 0.02 });
            });
            this.strings(P[0].pad, t, 2.8, 0.03, 900, 0.8, this.sfxBus);
            break;
          case 'error':
            this.tone(880, t, 0.14, { type: 'square', vol: 0.035 });
            this.tone(659, t + 0.14, 0.25, { type: 'square', vol: 0.035 });
            [0.55, 0.8, 1.05].forEach((d) => this.tone(440, t + d, 0.1, { type: 'square', vol: 0.02 }));
            this.tom(t + 0.1, 0.25, 60, this.sfxBus);
            break;
          case 'popup':
            this.tone(1046.5 * k, t, 0.3, { vol: 0.06 });
            this.tone(1568 * k, t + 0.09, 0.5, { vol: 0.05, delay: true });
            break;
          case 'trash':
            this.nhit(t, 0.6, { type: 'lowpass', f: 4000, f2: 200, vol: 0.25 });
            this.crumple(t + 0.1);
            this.tom(t + 0.55, 0.25, 55, this.sfxBus);
            break;
          case 'crumple':
            this.crumple(t, 18);
            break;
          case 'installFail':
            [523.25, 659.25, 783.99].forEach((f, i) => this.tone(f * k, t + i * 0.18, 0.16, { type: 'square', vol: 0.025 }));
            this.tone(220, t + 0.6, 0.8, { type: 'sawtooth', f2: 80, vol: 0.06 });
            break;
          case 'connect':
            this.nhit(t, 0.03, { f: 3000, vol: 0.3 });
            this.bell(783.99 * k, t + 0.15, 0.05, 2.5);
            this.bell(1174.66 * k, t + 0.32, 0.04, 2.5);
            break;
          case 'ding':
            this.bell(P[0].arp[3] * 2, t, 0.06, 3.5);
            break;
          case 'galaxy':
            for (let i = 0; i < 9; i++) this.bell(P[i % 4].arp[(i * 3) % 4] * 2, t + i * 0.22 + R() * 0.1, 0.018 + R() * 0.02, 4);
            this.strings([P[0].bass * 4, P[0].bass * 6], t, 3.5, 0.05, 700, 1.5, this.sfxBus);
            break;
          case 'eclipse':
            this.choir([P[0].pad[0], P[0].pad[1], P[0].pad[2]], t, 2.5, 0.1);
            this.tone(55 * k, t, 3, { vol: 0.3, attack: 0.8, bus: this.dryBus });
            break;
          case 'signal':
            [0.08, 0.08, 0.25, 0.08, 0.25].reduce((acc, d) => { this.flatTone(1000, t + acc, d, 0.045); return acc + d + 0.09; }, 0);
            this.nhit(t + 1.1, 1.5, { type: 'highpass', f: 2000, vol: 0.08, attack: 0.3 });
            break;
          case 'choirHit':
            this.choir(P[0].pad.slice(0, 3).map((f) => f * 2), t, 2.6, 0.12);
            break;
          case 'swell':
            this.strings(P[0].pad.concat([P[0].pad[1] * 2]), t, 3.2, 0.09, 2600, 1.2, this.sfxBus, 1.2);
            break;
          case 'stamp':
            this.tom(t, 0.7, 50, this.dryBus);
            this.nhit(t, 0.15, { type: 'lowpass', f: 1200, vol: 0.5 });
            this.nhit(t, 0.06, { f: 2500, vol: 0.3 });
            break;
          case 'comic':
            this.nhit(t, 0.12, { f: 1500, vol: 0.35 });
            this.tone(900, t, 0.6, { f2: 180, type: 'triangle', vol: 0.08 });
            break;
          case 'clink':
            this.tone(2637, t, 1.6, { vol: 0.05, delay: true });
            this.tone(3951, t, 0.8, { vol: 0.025 });
            break;
          case 'newspaper':
            for (let i = 0; i < 6; i++) this.nhit(t + i * 0.07, 0.09, { f: 3500, q: 0.6, vol: 0.12, pan: R() * 2 - 1 });
            break;
          case 'thunder':
            this.nhit(t, 3.5, { type: 'lowpass', f: 900, f2: 90, vol: 0.5, attack: 0.05 });
            this.nhit(t + 0.3, 3, { type: 'lowpass', f: 200, vol: 0.4, attack: 0.6 });
            break;
          case 'petal': {
            const notes = P[0].arp.map((f) => f * 2).reverse().concat([...P[0].arp].reverse());
            notes.forEach((f, i) => this.tone(f, t + i * 0.09, 1.6, { type: 'triangle', vol: 0.05, delay: true }));
            break;
          }
          case 'wish':
            this.breath(t);
            this.sfx('petal', delay + 900);
            break;
          case 'breath':
            this.breath(t);
            break;
          case 'lightsOff':
            for (let i = 0; i < 6; i++) this.nhit(t + i * 0.32, 0.03, { f: 2500, vol: 0.18, pan: R() * 2 - 1 });
            this.tone(P[0].bass * 4, t + 2, 2.5, { vol: 0.12, attack: 0.3, bus: this.dryBus });
            break;
          case 'puddle':
            this.tone(1400, t, 0.18, { f2: 500, vol: 0.07, delay: true });
            this.tone(1100, t + 0.45, 0.18, { f2: 400, vol: 0.05, delay: true });
            break;
          case 'carPass':
            this.carPass(t);
            break;
          case 'busy':
            for (let i = 0; i < 4; i++) this.flatTone(425, t + i * 0.9, 0.45, 0.06);
            break;
          case 'voicemail':
            this.flatTone(1000, t, 0.6, 0.05);
            break;
          case 'door':
            this.nhit(t, 0.04, { f: 3000, vol: 0.3 });
            this.nhit(t + 0.12, 0.05, { f: 2200, vol: 0.3 });
            this.tom(t + 0.2, 0.6, 60, this.dryBus);
            break;
          case 'party': {
            // radosna muzyka za zamkniętymi drzwiami
            const lp = c.createBiquadFilter();
            lp.type = 'lowpass';
            lp.frequency.value = 280;
            const pg = c.createGain();
            pg.gain.setValueAtTime(0.0001, t);
            pg.gain.linearRampToValueAtTime(1, t + 0.4);
            pg.gain.setValueAtTime(1, t + 3.4);
            pg.gain.linearRampToValueAtTime(0.0001, t + 4.2);
            lp.connect(pg);
            pg.connect(this.sfxBus);
            const beat = 60 / 124;
            const chords = [[261.63, 329.63, 392], [220, 261.63, 329.63], [174.61, 220, 261.63], [196, 246.94, 293.66]];
            for (let i = 0; i < 8; i++) {
              const tt = t + i * beat;
              this.tone(110, tt, 0.25, { f2: 45, vol: 0.5, bus: lp });
              if (i % 2 === 1) chords[(i >> 1) % 4].forEach((f) => this.tone(f, tt, 0.3, { type: 'sawtooth', vol: 0.05, bus: lp }));
            }
            this.nhit(t, 4, { f: 400, q: 0.6, vol: 0.06, attack: 0.5 });
            break;
          }
          case 'shadow':
            this.nhit(t, 1.5, { type: 'lowpass', f: 200, f2: 3000, vol: 0.15, attack: 1.4 });
            this.tone(P[0].bass * 2, t + 1.5, 2.5, { vol: 0.25, bus: this.dryBus });
            break;
          case 'shutter':
            this.nhit(t, 0.025, { type: 'highpass', f: 3000, vol: 0.35 });
            this.nhit(t + 0.07, 0.04, { type: 'highpass', f: 2000, vol: 0.25 });
            break;
          case 'glassSoft':
            this.tone(P[0].arp[2] * 4, t, 2.5, { vol: 0.04, delay: true });
            this.tone(P[0].arp[0] * 4, t + 0.6, 2.5, { vol: 0.03, delay: true });
            break;
          case 'nosignal':
            this.nhit(t, 1.6, { type: 'highpass', f: 1500, vol: 0.14, attack: 0.01 });
            this.flatTone(1000, t + 1.6, 1.2, 0.04);
            break;
          case 'rewind': {
            const o = c.createOscillator();
            o.type = 'sawtooth';
            o.frequency.setValueAtTime(300, t);
            o.frequency.exponentialRampToValueAtTime(2400, t + 1);
            const lf = c.createOscillator();
            lf.frequency.value = 18;
            const lg = c.createGain();
            lg.gain.value = 120;
            lf.connect(lg);
            lg.connect(o.frequency);
            const lp = c.createBiquadFilter();
            lp.type = 'lowpass';
            lp.frequency.value = 3000;
            const g = c.createGain();
            g.gain.setValueAtTime(0.04, t);
            g.gain.setValueAtTime(0.04, t + 0.95);
            g.gain.linearRampToValueAtTime(0.0001, t + 1);
            o.connect(lp);
            lp.connect(g);
            g.connect(this.sfxBus);
            o.start(t); lf.start(t);
            o.stop(t + 1.05); lf.stop(t + 1.05);
            this.nhit(t + 1.05, 0.03, { f: 2500, vol: 0.3 });
            break;
          }
          case 'tapeStop':
            this.tone(400, t, 0.9, { type: 'sawtooth', f2: 30, vol: 0.05 });
            this.nhit(t + 0.9, 0.03, { f: 2000, vol: 0.3 });
            break;
          case 'pencil':
            for (let i = 0; i < 10; i++) this.nhit(t + i * 0.07 + R() * 0.03, 0.05, { f: 4500, q: 1.5, vol: 0.09 });
            break;
          case 'tally':
            for (let s = 0; s < 5; s++) this.nhit(t + s * 0.35, 0.18, { f: 4000, f2: 2500, q: 1.2, vol: 0.12 });
            break;
          case 'paper':
            this.nhit(t, 0.5, { f: 2500, q: 0.5, vol: 0.12, attack: 0.1 });
            this.nhit(t + 0.5, 0.3, { f: 3500, vol: 0.08 });
            break;
          case 'thoughts':
            for (let i = 0; i < 26; i++) this.nhit(t + i * 0.11 + R() * 0.08, 0.12 + R() * 0.12, { f: 800 + R() * 2200, q: 4, vol: 0.05 + R() * 0.04, pan: R() * 2 - 1 });
            for (let i = 0; i < 5; i++) this.heartbeat(t + i * 0.42, 0.6);
            break;
          case 'vibrate':
            for (let i = 0; i < 2; i++) {
              const o = c.createOscillator();
              o.type = 'square';
              o.frequency.value = 160;
              const lp = c.createBiquadFilter();
              lp.type = 'lowpass';
              lp.frequency.value = 400;
              const g = c.createGain();
              const tt = t + i * 0.5;
              g.gain.setValueAtTime(0.0001, tt);
              g.gain.linearRampToValueAtTime(0.12, tt + 0.01);
              g.gain.setValueAtTime(0.12, tt + 0.34);
              g.gain.linearRampToValueAtTime(0.0001, tt + 0.35);
              o.connect(lp); lp.connect(g); g.connect(this.dryBus);
              o.start(tt); o.stop(tt + 0.4);
            }
            break;
          case 'notif':
            this.bell(1318.5, t, 0.06, 2);
            this.bell(1975.5, t + 0.12, 0.05, 2.5);
            break;
          case 'notifSad':
            this.piano(523.25 * k, t, 0.45, 2.5, this.sfxBus);
            this.piano(415.3 * k, t + 0.35, 0.4, 3.2, this.sfxBus);
            break;
          case 'heartSkip':
            this.heartbeat(t, 0.9);
            break;
          case 'heartbeatFast':
            for (let i = 0; i < 6; i++) this.heartbeat(t + i * 0.42, 0.7);
            break;
          case 'clock':
            for (let i = 0; i < 4; i++) {
              this.nhit(t + i, 0.02, { f: i % 2 ? 2600 : 3200, q: 3, vol: 0.14 });
              this.tone(i % 2 ? 1500 : 1800, t + i, 0.05, { type: 'square', vol: 0.02 });
            }
            break;
          case 'crossing':
            for (let i = 0; i < 14; i++) {
              this.nhit(t + i * 0.16, 0.02, { f: 2200, vol: 0.15 });
              this.tone(900, t + i * 0.16, 0.03, { type: 'square', vol: 0.02 });
            }
            [2.7, 3.7].forEach((d) => this.nhit(t + d, 0.03, { f: 1400, vol: 0.2 }));
            break;
          case 'dust':
            for (let i = 0; i < 30; i++) this.tone(2000 + R() * 4000, t + R() * 2.4, 0.3 + R() * 0.4, { vol: 0.012 + R() * 0.015, pan: R() * 2 - 1, delay: i % 5 === 0 });
            this.nhit(t, 2.5, { f: 900, q: 0.4, vol: 0.05, attack: 1.2 });
            break;
          case 'queue':
            for (let i = 0; i < 4; i++) this.tone(1046.5 * k, t + i * 0.7, 0.4, { vol: 0.04, delay: true });
            break;
          case 'matchFound':
            [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => this.bell(f, t + i * 0.05, 0.05, 2.5));
            this.tone(392, t + 1.6, 0.35, { type: 'square', vol: 0.04 });
            this.tone(311.13, t + 1.95, 0.7, { type: 'square', vol: 0.04 });
            break;
          case 'captchaFail':
            for (let i = 0; i < 2; i++) this.tone(150, t + i * 0.3, 0.22, { type: 'square', vol: 0.05 });
            break;
          case 'achievement':
            [783.99, 987.77, 1174.66, 1567.98].forEach((f, i) => this.bell(f, t + i * 0.08, 0.05, 2));
            this.nhit(t + 0.3, 0.6, { type: 'highpass', f: 6000, vol: 0.05 });
            break;
          case 'locked':
            this.tom(t, 0.6, 55, this.dryBus);
            for (let i = 0; i < 5; i++) this.tone(3000 + R() * 1000, t + 0.05 + i * 0.05, 0.1, { vol: 0.02 });
            break;
          case 'bells': {
            const lp = c.createBiquadFilter();
            lp.type = 'lowpass';
            lp.frequency.value = 1800;
            lp.connect(this.sfxBus);
            [783.99, 659.25, 523.25, 587.33, 783.99, 659.25].forEach((f, i) => this.bell(f, t + i * 0.45, 0.04, 4, lp));
            break;
          }
          case 'musicBox':
            [P[0].arp[3], P[0].arp[2], P[0].arp[1], P[0].arp[2], P[0].arp[0]].forEach((f, i) => this.musicBox(f * 2, t + i * 0.42));
            break;
          case 'typing':
            for (let i = 0; i < 12; i++) this.keyClickAt(t + i * 0.07 + R() * 0.03);
            break;
          case 'whoosh':
            this.whoosh();
            break;
          case 'sigh':
            this.sighDown();
            break;
          case 'glass':
            for (let i = 0; i < 14; i++) this.tone(2200 + R() * 5000, t + Math.pow(R(), 1.5) * 0.5, 0.1 + R() * 0.3, { vol: 0.04, pan: R() * 2 - 1 });
            this.nhit(t, 0.5, { type: 'highpass', f: 3500, vol: 0.2 });
            break;
          default:
            break;
        }
      }

      /* ---------- tło dźwiękowe (ambient) ---------- */
      stopAmbience() {
        this.ambToken++;
        this.ambTimers.forEach((id) => clearTimeout(id));
        this.ambTimers = [];
        if (this.amb && this.ctx) {
          const now = this.ctx.currentTime;
          const { out, srcs } = this.amb;
          out.gain.cancelScheduledValues(now);
          out.gain.setValueAtTime(Math.max(0.0001, out.gain.value), now);
          out.gain.linearRampToValueAtTime(0.0001, now + 1.2);
          srcs.forEach((s) => { try { s.stop(now + 1.3); } catch (e) {} });
        }
        this.amb = null;
      }

      setAmbience(type) {
        this.stopAmbience();
        this.ambType = type || 'none';
        if (!this.ctx || !type || type === 'none') return;
        const token = this.ambToken;
        const c = this.ctx, t = c.currentTime, k = this.keyRatio, R = () => Math.random();
        const out = c.createGain();
        out.gain.setValueAtTime(0.0001, t);
        out.gain.linearRampToValueAtTime(1, t + 2.5);
        out.connect(this.ambBus);
        const srcs = [];
        this.amb = { out, srcs };
        const noiseLayer = (ft, f, q, vol) => {
          const n = c.createBufferSource();
          n.buffer = this.noiseBuf;
          n.loop = true;
          const fl = c.createBiquadFilter();
          fl.type = ft; fl.frequency.value = f; fl.Q.value = q;
          const g = c.createGain();
          g.gain.value = vol;
          n.connect(fl); fl.connect(g); g.connect(out);
          n.start(t, R() * 2);
          srcs.push(n);
          return { fl, g };
        };
        const drone = (f, vol, ot = 'sine') => {
          const o = c.createOscillator();
          o.type = ot; o.frequency.value = f;
          const g = c.createGain();
          g.gain.value = vol;
          o.connect(g); g.connect(out);
          o.start(t);
          srcs.push(o);
          return { o, g };
        };
        const lfo = (param, rate, depth) => {
          const l = c.createOscillator();
          l.frequency.value = rate;
          const lg = c.createGain();
          lg.gain.value = depth;
          l.connect(lg); lg.connect(param);
          l.start(t);
          srcs.push(l);
        };
        const every = (minMs, maxMs, fn) => {
          const loop = () => {
            if (this.ambToken !== token) return;
            if (this.live()) fn(this.ctx.currentTime + 0.03);
            this.ambTimers.push(setTimeout(loop, minMs + R() * (maxMs - minMs)));
          };
          this.ambTimers.push(setTimeout(loop, minMs));
        };

        if (type === 'rain') {
          noiseLayer('bandpass', 2500, 0.5, 0.09);
          noiseLayer('lowpass', 400, 0.5, 0.06);
          every(150, 500, (tt) => this.tone(2000 + R() * 2500, tt, 0.05, { f2: 800, vol: 0.01 + R() * 0.015, bus: out, pan: R() * 2 - 1 }));
          every(14000, 26000, (tt) => {
            this.nhit(tt, 3.5, { type: 'lowpass', f: 500, f2: 80, vol: 0.25, attack: 0.4, bus: out });
          });
        } else if (type === 'space') {
          const d1 = drone(55 * k, 0.05);
          drone(82.4 * k, 0.03);
          lfo(d1.g.gain, 0.1, 0.02);
          const w = noiseLayer('bandpass', 1200, 8, 0.05);
          lfo(w.fl.frequency, 0.07, 600);
          every(2500, 5500, (tt) => this.bell(this.progression[(R() * 4) | 0].arp[(R() * 4) | 0] * 4, tt, 0.012, 4, out));
        } else if (type === 'night') {
          noiseLayer('lowpass', 180, 0.7, 0.05);
          drone(50, 0.006);
          let tick = 0;
          every(1000, 1000, (tt) => {
            tick++;
            this.nhit(tt, 0.015, { f: tick % 2 ? 3200 : 2600, q: 3, vol: 0.07, bus: out });
          });
          every(15000, 30000, (tt) => this.carPass(tt, 0.05, out));
        } else if (type === 'city') {
          noiseLayer('lowpass', 250, 0.5, 0.07);
          every(4000, 9000, (tt) => this.carPass(tt, 0.08, out));
        } else if (type === 'wind') {
          const w = noiseLayer('bandpass', 500, 0.8, 0.07);
          lfo(w.fl.frequency, 0.13, 250);
          lfo(w.g.gain, 0.09, 0.04);
          every(3000, 7000, (tt) => this.tone(this.progression[0].arp[(R() * 4) | 0] * 4, tt, 2.5, { vol: 0.012, bus: out, delay: true }));
        } else if (type === 'tape') {
          noiseLayer('highpass', 4000, 0.5, 0.02);
          drone(50, 0.01);
          drone(100, 0.004);
          every(60, 300, (tt) => this.nhit(tt, 0.008, { f: 1500 + R() * 3000, vol: 0.03 + R() * 0.04, bus: out }));
        } else if (type === 'digital') {
          drone(60, 0.008);
          noiseLayer('bandpass', 3000, 6, 0.01);
          every(600, 2000, (tt) => {
            for (let i = 0; i < 3; i++) this.tone(2000 + R() * 2000, tt + i * 0.04, 0.03, { type: 'square', vol: 0.006, bus: out });
          });
        }
      }

      init() {
        if (!this.ctx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AC();
          const c = this.ctx;

          this.master = c.createGain();
          this.master.gain.value = 0.95;
          this.comp = c.createDynamicsCompressor();
          this.comp.threshold.value = -16;
          this.comp.knee.value = 12;
          this.comp.ratio.value = 5;
          this.comp.attack.value = 0.004;
          this.comp.release.value = 0.25;
          this.comp.connect(this.master);
          this.master.connect(c.destination);

          this.reverb = c.createConvolver();
          this.reverb.buffer = this.makeImpulse(5, 2.4);
          this.reverbOut = c.createGain();
          this.reverbOut.gain.value = 0.85;
          this.reverb.connect(this.reverbOut);
          this.reverbOut.connect(this.comp);

          this.delay = c.createDelay(2);
          this.delay.delayTime.value = (60 / this.bpm) * 0.75;
          this.delayFb = c.createGain();
          this.delayFb.gain.value = 0.38;
          this.delayLp = c.createBiquadFilter();
          this.delayLp.type = 'lowpass';
          this.delayLp.frequency.value = 2200;
          this.delay.connect(this.delayLp);
          this.delayLp.connect(this.delayFb);
          this.delayFb.connect(this.delay);
          this.delayOut = c.createGain();
          this.delayOut.gain.value = 0.25;
          this.delayLp.connect(this.delayOut);
          this.delayOut.connect(this.comp);
          this.delayOut.connect(this.reverb);

          this.musicBus = c.createGain();
          this.musicFilter = c.createBiquadFilter();
          this.musicFilter.type = 'lowpass';
          this.musicFilter.frequency.value = 18000;
          this.musicFilter.Q.value = 0.7;
          this.musicBus.connect(this.musicFilter);
          this.musicFilter.connect(this.comp);
          this.musicSend = c.createGain();
          this.musicSend.gain.value = 0.6;
          this.musicFilter.connect(this.musicSend);
          this.musicSend.connect(this.reverb);

          this.sfxBus = c.createGain();
          this.sfxBus.connect(this.comp);
          this.sfxSend = c.createGain();
          this.sfxSend.gain.value = 0.75;
          this.sfxBus.connect(this.sfxSend);
          this.sfxSend.connect(this.reverb);

          this.dryBus = c.createGain();
          this.dryBus.connect(this.comp);

          this.ambBus = c.createGain();
          this.ambBus.gain.value = 1;
          this.ambBus.connect(this.musicBus);

          this.distCurve = this.makeDistCurve(18);
          this.noiseBuf = this.makeNoise(3);
        }
        if (this.ctx.state === 'suspended') this.ctx.resume();
        this.startScore();
      }

      /* ---------- narzędzia ---------- */
      makeImpulse(duration, decay) {
        const c = this.ctx, rate = c.sampleRate, len = Math.floor(rate * duration);
        const buf = c.createBuffer(2, len, rate);
        for (let ch = 0; ch < 2; ch++) {
          const d = buf.getChannelData(ch);
          let lp = 0;
          for (let i = 0; i < len; i++) {
            const k = i / len;
            const a = 0.85 - 0.7 * k;
            lp += a * ((Math.random() * 2 - 1) - lp);
            const fadeIn = i < rate * 0.01 ? i / (rate * 0.01) : 1;
            d[i] = lp * Math.pow(1 - k, decay) * fadeIn;
          }
        }
        return buf;
      }
      makeNoise(sec) {
        const c = this.ctx, len = Math.floor(c.sampleRate * sec);
        const b = c.createBuffer(1, len, c.sampleRate);
        const d = b.getChannelData(0);
        for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
        return b;
      }
      makeDistCurve(k) {
        const n = 44100, curve = new Float32Array(n), deg = Math.PI / 180;
        for (let i = 0; i < n; i++) {
          const x = (i * 2) / n - 1;
          curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
        }
        return curve;
      }
      noiseSrc(t, dur) {
        const s = this.ctx.createBufferSource();
        s.buffer = this.noiseBuf;
        s.loop = true;
        s.start(t, Math.random() * 2);
        s.stop(t + dur + 0.05);
        return s;
      }
      live() { return this.ctx && !this.muted; }

      /* ---------- instrumenty ---------- */
      piano(freq, t, vel = 0.5, dur = 3, bus = this.musicBus, delaySend = true) {
        const c = this.ctx;
        const lp = c.createBiquadFilter();
        lp.type = 'lowpass';
        lp.frequency.setValueAtTime(Math.min(12000, freq * 6 + 900 * vel), t);
        lp.frequency.exponentialRampToValueAtTime(Math.max(300, freq * 1.5), t + dur);
        lp.connect(bus);
        if (delaySend) lp.connect(this.delay);
        [[1, 1, 1], [2, 0.42, 0.6], [3, 0.18, 0.4], [4.02, 0.08, 0.25]].forEach(([m, amp, dk]) => {
          const o = c.createOscillator();
          o.type = m === 1 ? 'triangle' : 'sine';
          o.frequency.setValueAtTime(freq * m, t);
          o.detune.value = (Math.random() - 0.5) * 6;
          const g = c.createGain();
          const peak = 0.11 * vel * amp;
          g.gain.setValueAtTime(0.0001, t);
          g.gain.linearRampToValueAtTime(peak, t + 0.006);
          g.gain.exponentialRampToValueAtTime(peak * 0.35, t + 0.25 * dk + 0.05);
          g.gain.exponentialRampToValueAtTime(0.0001, t + dur * dk + 0.2);
          o.connect(g);
          g.connect(lp);
          o.start(t);
          o.stop(t + dur * dk + 0.3);
        });
      }

      musicBox(freq, t) {
        const c = this.ctx;
        [[1, 0.06, 2.4], [3.0, 0.012, 0.6], [4.0, 0.008, 0.4]].forEach(([m, v, d]) => {
          const o = c.createOscillator();
          o.type = 'sine';
          o.frequency.setValueAtTime(freq * m, t);
          const g = c.createGain();
          g.gain.setValueAtTime(0.0001, t);
          g.gain.linearRampToValueAtTime(v, t + 0.004);
          g.gain.exponentialRampToValueAtTime(0.0001, t + d);
          o.connect(g);
          g.connect(this.musicBus);
          g.connect(this.delay);
          o.start(t);
          o.stop(t + d + 0.05);
        });
      }

      strings(freqs, t, dur, vol = 0.04, cutoff = 1200, attack = 1.2, bus = this.musicBus, release = 0.8) {
        const c = this.ctx;
        const g = c.createGain();
        const lp = c.createBiquadFilter();
        lp.type = 'lowpass';
        lp.Q.value = 0.5;
        lp.frequency.setValueAtTime(cutoff * 0.5, t);
        lp.frequency.linearRampToValueAtTime(cutoff, t + attack);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + attack);
        g.gain.setValueAtTime(vol, t + Math.max(attack, dur - 1.2));
        g.gain.exponentialRampToValueAtTime(0.0001, t + Math.max(attack, dur) + release);
        lp.connect(g);
        g.connect(bus);
        const end = t + Math.max(attack, dur) + release + 0.1;
        const lfo = c.createOscillator();
        lfo.frequency.value = 5.2;
        const lfoG = c.createGain();
        lfoG.gain.value = 5;
        lfo.connect(lfoG);
        freqs.forEach((f) => {
          [-9, 0, 8].forEach((det) => {
            const o = c.createOscillator();
            o.type = 'sawtooth';
            o.frequency.setValueAtTime(f, t);
            o.detune.value = det;
            lfoG.connect(o.detune);
            const og = c.createGain();
            og.gain.value = 1 / (freqs.length * 3);
            o.connect(og);
            og.connect(lp);
            o.start(t);
            o.stop(end);
          });
        });
        lfo.start(t);
        lfo.stop(end);
      }

      choir(freqs, t, dur, vol) {
        const c = this.ctx;
        const out = c.createGain();
        out.gain.setValueAtTime(0.0001, t);
        out.gain.linearRampToValueAtTime(vol, t + 1.0);
        out.gain.setValueAtTime(vol, t + dur * 0.55);
        out.gain.exponentialRampToValueAtTime(0.0001, t + dur + 1.5);
        out.connect(this.sfxBus);
        const mix = c.createGain();
        [[700, 6, 1], [1150, 8, 0.5], [2700, 10, 0.18]].forEach(([fq, q, a]) => {
          const bp = c.createBiquadFilter();
          bp.type = 'bandpass';
          bp.frequency.value = fq;
          bp.Q.value = q;
          const ga = c.createGain();
          ga.gain.value = a * 3;
          mix.connect(bp);
          bp.connect(ga);
          ga.connect(out);
        });
        const lfo = c.createOscillator();
        lfo.frequency.value = 4.8;
        const lg = c.createGain();
        lg.gain.value = 10;
        lfo.connect(lg);
        freqs.forEach((fr) => {
          [-12, 0, 11].forEach((d) => {
            const o = c.createOscillator();
            o.type = 'sawtooth';
            o.frequency.value = fr;
            o.detune.value = d;
            lg.connect(o.detune);
            const og = c.createGain();
            og.gain.value = 0.12;
            o.connect(og);
            og.connect(mix);
            o.start(t);
            o.stop(t + dur + 1.6);
          });
        });
        lfo.start(t);
        lfo.stop(t + dur + 1.6);
      }

      bass(f, t, dur, vol) {
        const c = this.ctx;
        const g = c.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + 0.15);
        g.gain.setValueAtTime(vol, t + dur * 0.7);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur + 0.4);
        g.connect(this.musicBus);
        [[1, 'sine', 1], [2, 'triangle', 0.5], [4, 'sine', 0.12]].forEach(([m, type, a]) => {
          const o = c.createOscillator();
          o.type = type;
          o.frequency.setValueAtTime(f * m, t);
          const og = c.createGain();
          og.gain.value = a;
          o.connect(og);
          og.connect(g);
          o.start(t);
          o.stop(t + dur + 0.5);
        });
      }

      lead(f, t, dur, vol = 0.05) {
        const c = this.ctx;
        const g = c.createGain();
        const lp = c.createBiquadFilter();
        lp.type = 'lowpass';
        lp.Q.value = 0.8;
        lp.frequency.setValueAtTime(900, t);
        lp.frequency.linearRampToValueAtTime(2200, t + Math.min(dur, 0.8));
        const atk = Math.min(0.35, dur * 0.3);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + atk);
        g.gain.setValueAtTime(vol, t + Math.max(atk, dur - 0.25));
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur + 0.5);
        lp.connect(g);
        g.connect(this.musicBus);
        const lfo = c.createOscillator();
        lfo.frequency.value = 5.4;
        const lg = c.createGain();
        lg.gain.setValueAtTime(0, t);
        lg.gain.linearRampToValueAtTime(16, t + Math.min(0.7, dur));
        lfo.connect(lg);
        [-7, 7].forEach((det) => {
          const o = c.createOscillator();
          o.type = 'sawtooth';
          o.frequency.setValueAtTime(f, t);
          o.detune.value = det;
          lg.connect(o.detune);
          o.connect(lp);
          o.start(t);
          o.stop(t + dur + 0.6);
        });
        lfo.start(t);
        lfo.stop(t + dur + 0.6);
      }

      kick(t, vol = 0.6, bus = this.musicBus) {
        const c = this.ctx;
        const o = c.createOscillator();
        const g = c.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(130, t);
        o.frequency.exponentialRampToValueAtTime(42, t + 0.32);
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.6);
        o.connect(g);
        g.connect(bus);
        o.start(t);
        o.stop(t + 0.65);
        const n = this.noiseSrc(t, 0.03);
        const bp = c.createBiquadFilter();
        bp.type = 'bandpass';
        bp.frequency.value = 2500;
        const ng = c.createGain();
        ng.gain.setValueAtTime(vol * 0.25, t);
        ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.03);
        n.connect(bp);
        bp.connect(ng);
        ng.connect(bus);
      }

      snare(t, vol) {
        const c = this.ctx;
        const n = this.noiseSrc(t, 0.4);
        const bp = c.createBiquadFilter();
        bp.type = 'bandpass';
        bp.frequency.value = 1600;
        bp.Q.value = 0.7;
        const g = c.createGain();
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.35);
        n.connect(bp);
        bp.connect(g);
        g.connect(this.musicBus);
        const o = c.createOscillator();
        o.type = 'triangle';
        o.frequency.setValueAtTime(210, t);
        o.frequency.exponentialRampToValueAtTime(140, t + 0.1);
        const og = c.createGain();
        og.gain.setValueAtTime(vol * 0.6, t);
        og.gain.exponentialRampToValueAtTime(0.0001, t + 0.15);
        o.connect(og);
        og.connect(this.musicBus);
        o.start(t);
        o.stop(t + 0.2);
      }

      tom(t, vol, f = 90, bus = this.musicBus) {
        const c = this.ctx;
        const o = c.createOscillator();
        o.type = 'sine';
        o.frequency.setValueAtTime(f * 1.6, t);
        o.frequency.exponentialRampToValueAtTime(f, t + 0.25);
        const g = c.createGain();
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.7);
        o.connect(g);
        g.connect(bus);
        o.start(t);
        o.stop(t + 0.75);
        const n = this.noiseSrc(t, 0.08);
        const lp = c.createBiquadFilter();
        lp.type = 'lowpass';
        lp.frequency.value = 700;
        const ng = c.createGain();
        ng.gain.setValueAtTime(vol * 0.5, t);
        ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.08);
        n.connect(lp);
        lp.connect(ng);
        ng.connect(bus);
      }

      bell(f, t, vol = 0.05, dur = 3.5, bus = this.sfxBus) {
        const c = this.ctx;
        [[1, 1], [2.76, 0.35], [5.4, 0.12]].forEach(([m, a]) => {
          const o = c.createOscillator();
          o.type = 'sine';
          o.frequency.setValueAtTime(f * m, t);
          const g = c.createGain();
          const d = dur / Math.sqrt(m);
          g.gain.setValueAtTime(0.0001, t);
          g.gain.linearRampToValueAtTime(vol * a, t + 0.004);
          g.gain.exponentialRampToValueAtTime(0.0001, t + d);
          o.connect(g);
          g.connect(bus);
          g.connect(this.delay);
          o.start(t);
          o.stop(t + d + 0.05);
        });
      }

      heartbeat(t, vol) {
        const c = this.ctx;
        [[0, 1], [0.19, 0.68]].forEach(([off, amp]) => {
          const tt = t + off, v = vol * amp;
          const o = c.createOscillator();
          o.type = 'sine';
          o.frequency.setValueAtTime(70, tt);
          o.frequency.exponentialRampToValueAtTime(38, tt + 0.16);
          const g = c.createGain();
          g.gain.setValueAtTime(0.0001, tt);
          g.gain.linearRampToValueAtTime(v * 0.9, tt + 0.01);
          g.gain.exponentialRampToValueAtTime(0.0001, tt + 0.26);
          o.connect(g);
          g.connect(this.dryBus);
          o.start(tt);
          o.stop(tt + 0.3);
          // słyszalne „tąpnięcie” także na głośniku telefonu
          const o2 = c.createOscillator();
          o2.type = 'triangle';
          o2.frequency.setValueAtTime(150, tt);
          o2.frequency.exponentialRampToValueAtTime(80, tt + 0.08);
          const lp = c.createBiquadFilter();
          lp.type = 'lowpass';
          lp.frequency.value = 420;
          const g2 = c.createGain();
          g2.gain.setValueAtTime(0.0001, tt);
          g2.gain.linearRampToValueAtTime(v * 0.4, tt + 0.006);
          g2.gain.exponentialRampToValueAtTime(0.0001, tt + 0.12);
          o2.connect(lp);
          lp.connect(g2);
          g2.connect(this.dryBus);
          o2.start(tt);
          o2.stop(tt + 0.15);
        });
      }

      /* ---------- sekwencer muzyki ---------- */
      startScore() {
        if (this.running || !this.ctx) return;
        this.running = true;
        this.nextStepTime = this.ctx.currentTime + 0.1;
        this.nextHeartTime = this.ctx.currentTime + 0.3;
        this.timer = setInterval(() => this.tick(), 40);
      }

      tick() {
        const c = this.ctx;
        const ahead = c.currentTime + 0.25;
        const stepDur = 60 / this.bpm / 2;
        while (this.nextStepTime < ahead) {
          this.playStep(this.step, this.nextStepTime, stepDur);
          this.step++;
          this.nextStepTime += stepDur;
        }
        if (this.heartOn) {
          while (this.nextHeartTime < ahead) {
            const tt = this.nextHeartTime;
            const muted = tt >= this.heartMuteFrom && tt <= this.heartMuteTo;
            if (!muted) {
              if (!this.muted) this.heartbeat(tt, this.heartVol);
              if (this.onHeartbeat) {
                const cb = this.onHeartbeat, v = this.heartVol;
                setTimeout(() => cb(v), Math.max(0, (tt - c.currentTime) * 1000));
              }
            }
            this.nextHeartTime += 60 / this.heartRate;
          }
        } else {
          this.nextHeartTime = ahead;
        }
      }

      playStep(step, t, sd) {
        if (this.muted) return;
        const bar = Math.floor(step / 8) % 4;
        const s = step % 8;
        const ch = this.progression[bar];
        const I = this.intensity;
        const barDur = sd * 8;

        if (s === 0) {
          if (I === -1) {
            this.strings(ch.pad.slice(0, 3), t, barDur, 0.018, 700, 2);
          } else {
            this.strings(I >= 1 ? ch.pad : ch.pad.slice(0, 3), t, barDur, [0.03, 0.05, 0.075][I], [800, 1500, 2600][I], 1.0);
            this.bass(ch.bass, t, barDur, [0.12, 0.2, 0.26][I]);
          }
          if (I >= 1) {
            let mt = t;
            ch.mel.forEach(([f, beats]) => {
              const d = beats * sd * 2;
              this.lead(f, mt, d * 0.98, I === 2 ? 0.055 : 0.04);
              if (I === 2) this.lead(f * 2, mt, d * 0.98, 0.02);
              mt += d;
            });
          }
        }

        const af = ch.arp[this.arpPattern[s]];
        if (I === -1) {
          if (s % 2 === 0) this.musicBox(af * 2, t);
        } else {
          const vel = (s === 0 ? 0.75 : 0.5) * [0.8, 0.9, 1.0][I] * (0.85 + Math.random() * 0.3);
          this.piano(af, t, vel, 2.6);
        }

        if (I >= 1) {
          if (s === 0) this.kick(t, I === 2 ? 0.75 : 0.5);
          if (s === 3 && I === 2) this.kick(t, 0.45);
          if (s === 4) this.snare(t, I === 2 ? 0.22 : 0.1);
          if (I === 2 && s === 7) this.tom(t, 0.3);
        }
      }

      /* ---------- sterowanie ---------- */
      setIntensity(i) { this.intensity = i; }
      setHeart(rate, vol) { this.heartRate = rate; this.heartVol = vol; this.heartOn = true; }
      setMusicTone(freq, sec) {
        if (!this.ctx) return;
        const now = this.ctx.currentTime, p = this.musicFilter.frequency;
        p.cancelScheduledValues(now);
        p.setValueAtTime(Math.max(40, p.value), now);
        p.exponentialRampToValueAtTime(freq, now + sec);
      }
      resetForFilm() {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        clearTimeout(this.heartTimeout);
        this.intensity = 0;
        this.heartMuteFrom = 0;
        this.heartMuteTo = 0;
        this.setHeart(62, 0.38);
        const g = this.musicBus.gain;
        g.cancelScheduledValues(now);
        g.setValueAtTime(Math.max(0.0001, g.value), now);
        g.linearRampToValueAtTime(1, now + 0.8);
        const f = this.musicFilter.frequency;
        f.cancelScheduledValues(now);
        f.setValueAtTime(18000, now);
      }
      outro() {
        this.setIntensity(-1);
        this.setHeart(48, 0.22);
        this.setMusicTone(5000, 6);
      }

      /* ---------- efekty emocjonalne ---------- */
      pop(isIncoming) {
        const c = this.ctx, now = c.currentTime;
        const o = c.createOscillator();
        const g = c.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(isIncoming ? 460 : 600, now);
        o.frequency.exponentialRampToValueAtTime(isIncoming ? 680 : 380, now + 0.08);
        g.gain.setValueAtTime(0.06, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
        o.connect(g);
        g.connect(this.dryBus);
        o.start(now);
        o.stop(now + 0.11);
      }

      messageOut(idx) {
        if (!this.live()) return;
        const t = this.ctx.currentTime + 0.01;
        const ch = this.progression[idx % 4];
        this.pop(false);
        this.piano(ch.arp[2] * 2, t, 0.55, 2.5, this.sfxBus);
        this.piano(ch.arp[0] * 2, t + 0.09, 0.4, 2.5, this.sfxBus);
      }

      // każda kolejna wiadomość – mocniejsze, bardziej uczuciowe wejście smyczków
      messageIn(idx) {
        if (!this.live()) return;
        const t = this.ctx.currentTime + 0.01;
        const ch = this.progression[idx % 4];
        const swell = Math.min(1, 0.3 + idx * 0.14);
        this.pop(true);
        this.piano(ch.arp[0], t, 0.6, 3.2, this.sfxBus);
        this.piano(ch.arp[2], t + 0.05, 0.5, 3.2, this.sfxBus);
        this.bell(ch.arp[3] * 2, t + 0.02, 0.03 + 0.02 * swell, 3.5);
        this.strings(ch.pad, t, 2.6, 0.02 + 0.05 * swell, 1000 + 1400 * swell, 0.25, this.sfxBus);
        this.tom(t, 0.2 * swell, 70, this.sfxBus);
      }

      keyClick(isDelete = false) {
        if (!this.live()) return;
        const c = this.ctx, t = c.currentTime;
        const n = this.noiseSrc(t, 0.04);
        const hp = c.createBiquadFilter();
        hp.type = 'highpass';
        hp.frequency.value = isDelete ? 2500 : 3500;
        const g = c.createGain();
        g.gain.setValueAtTime(isDelete ? 0.05 : 0.07, t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.035);
        n.connect(hp);
        hp.connect(g);
        g.connect(this.dryBus);
      }

      seenSigh() {
        if (!this.live()) return;
        const t = this.ctx.currentTime + 0.01;
        this.piano(415.30 * this.keyRatio, t, 0.5, 3, this.sfxBus);
        this.piano(349.23 * this.keyRatio, t + 0.38, 0.45, 3.5, this.sfxBus);
        this.strings([174.61 * this.keyRatio, 207.65 * this.keyRatio], t, 2.6, 0.035, 900, 0.6, this.sfxBus);
      }

      sighDown() {
        if (!this.live()) return;
        const t = this.ctx.currentTime + 0.01;
        this.piano(311.13 * this.keyRatio, t, 0.45, 3, this.sfxBus);
        this.piano(261.63 * this.keyRatio, t + 0.45, 0.4, 4, this.sfxBus);
        this.bell(1046.5 * this.keyRatio, t + 0.5, 0.025, 4);
      }

      whoosh(dur = 0.6, vol = 0.2) {
        if (!this.live()) return;
        const c = this.ctx, t = c.currentTime + 0.01;
        const n = this.noiseSrc(t, dur + 0.1);
        const bp = c.createBiquadFilter();
        bp.type = 'bandpass';
        bp.Q.value = 1.4;
        bp.frequency.setValueAtTime(300, t);
        bp.frequency.exponentialRampToValueAtTime(4500, t + dur * 0.7);
        bp.frequency.exponentialRampToValueAtTime(1200, t + dur);
        const g = c.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(vol, t + dur * 0.65);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        n.connect(bp);
        bp.connect(g);
        let node = g;
        if (c.createStereoPanner) {
          const p = c.createStereoPanner();
          const dir = Math.random() < 0.5 ? -1 : 1;
          p.pan.setValueAtTime(-dir * 0.8, t);
          p.pan.linearRampToValueAtTime(dir * 0.8, t + dur);
          g.connect(p);
          node = p;
        }
        node.connect(this.sfxBus);
      }

      // narastające napięcie + cisza tuż przed ciosem
      preTwist(lead, epic = false) {
        if (!this.ctx) return;
        const c = this.ctx, now = c.currentTime, hit = now + lead, cut = hit - 0.32;
        this.setHeart(epic ? 128 : 118, epic ? 0.9 : 0.8);
        this.heartMuteFrom = cut;
        this.heartMuteTo = hit + 1.8;

        const g = this.musicBus.gain;
        g.cancelScheduledValues(now);
        g.setValueAtTime(Math.max(0.0001, g.value), now);
        g.linearRampToValueAtTime(epic ? 1 : 0.6, now + lead * 0.5);
        g.linearRampToValueAtTime(0.0001, cut);
        if (this.muted) return;

        // szumowy riser
        const n = this.noiseSrc(now, lead);
        const bp = c.createBiquadFilter();
        bp.type = 'bandpass';
        bp.Q.value = 2;
        bp.frequency.setValueAtTime(250, now);
        bp.frequency.exponentialRampToValueAtTime(7000, cut);
        const ng = c.createGain();
        ng.gain.setValueAtTime(0.0001, now);
        ng.gain.exponentialRampToValueAtTime(epic ? 0.32 : 0.26, cut - 0.02);
        ng.gain.linearRampToValueAtTime(0.0001, cut + 0.01);
        n.connect(bp);
        bp.connect(ng);
        ng.connect(this.sfxBus);

        // rosnący ton napięcia
        const tlp = c.createBiquadFilter();
        tlp.type = 'lowpass';
        tlp.frequency.setValueAtTime(300, now);
        tlp.frequency.exponentialRampToValueAtTime(3200, cut);
        const tg = c.createGain();
        tg.gain.setValueAtTime(0.0001, now);
        tg.gain.exponentialRampToValueAtTime(0.09, cut - 0.02);
        tg.gain.linearRampToValueAtTime(0.0001, cut + 0.01);
        tlp.connect(tg);
        tg.connect(this.sfxBus);
        [110, 165].forEach((f) => {
          const o = c.createOscillator();
          o.type = 'sawtooth';
          o.frequency.setValueAtTime(f, now);
          o.frequency.exponentialRampToValueAtTime(f * 4, cut);
          o.connect(tlp);
          o.start(now);
          o.stop(cut + 0.05);
        });

        // „odwrócony” fortepian – akord zasysa się do ciszy
        [349.23, 415.30, 523.25, 698.46].forEach((f) => {
          const o = c.createOscillator();
          o.type = 'triangle';
          o.frequency.value = f * this.keyRatio;
          const og = c.createGain();
          og.gain.setValueAtTime(0.0001, now);
          og.gain.exponentialRampToValueAtTime(0.05, cut - 0.02);
          og.gain.linearRampToValueAtTime(0.0001, cut + 0.01);
          o.connect(og);
          og.connect(this.sfxBus);
          o.start(now);
          o.stop(cut + 0.05);
        });

        if (epic) {
          this.strings([174.61, 207.65, 261.63, 349.23, 415.30, 523.25].map((x) => x * this.keyRatio), now, lead - 0.32, 0.14, 3200, lead - 0.36, this.sfxBus, 0.04);
          let tt = now, gap = 0.34;
          while (tt < cut - 0.05) {
            this.tom(tt, 0.12 + 0.5 * ((tt - now) / lead), 75, this.sfxBus);
            gap = Math.max(0.06, gap * 0.87);
            tt += gap;
          }
        }
      }

      // GŁÓWNY CIOS przy „(oprócz ciebie)”
      twistImpact(big = false) {
        if (!this.ctx) return;
        const c = this.ctx, t = c.currentTime + 0.005, M = big ? 1.25 : 1;
        clearTimeout(this.heartTimeout);
        this.heartMuteFrom = t - 0.5;
        this.heartMuteTo = t + 1.8;
        this.heartTimeout = setTimeout(() => this.setHeart(big ? 50 : 56, big ? 0.3 : 0.38), 1800);

        // muzyka: cisza, potem wraca jak spod wody
        const g = this.musicBus.gain;
        g.cancelScheduledValues(t);
        g.setValueAtTime(0.0001, t);
        g.setValueAtTime(0.0001, t + 0.9);
        g.linearRampToValueAtTime(1, t + 3.8);
        const f = this.musicFilter.frequency;
        f.cancelScheduledValues(t);
        f.setValueAtTime(320, t);
        f.setValueAtTime(320, t + 0.9);
        f.exponentialRampToValueAtTime(18000, t + 6);
        if (this.muted) return;

        // 1. spadający sub-bas
        const sub = c.createOscillator();
        sub.type = 'sine';
        sub.frequency.setValueAtTime(150, t);
        sub.frequency.exponentialRampToValueAtTime(26, t + 2.8);
        const sg = c.createGain();
        sg.gain.setValueAtTime(0.95 * M, t);
        sg.gain.exponentialRampToValueAtTime(0.0001, t + 3.2);
        sub.connect(sg);
        sg.connect(this.dryBus);
        sub.start(t);
        sub.stop(t + 3.3);

        // 2. kinowy „BRAAM”
        const shaper = c.createWaveShaper();
        shaper.curve = this.distCurve;
        shaper.oversample = '2x';
        const blp = c.createBiquadFilter();
        blp.type = 'lowpass';
        blp.Q.value = 2;
        blp.frequency.setValueAtTime(160, t);
        blp.frequency.exponentialRampToValueAtTime(2800 * M, t + 0.22);
        blp.frequency.exponentialRampToValueAtTime(380, t + 4.5);
        const bg = c.createGain();
        const bEnd = big ? 6 : 4.8;
        bg.gain.setValueAtTime(0.0001, t);
        bg.gain.linearRampToValueAtTime(0.24 * M, t + 0.03);
        bg.gain.setValueAtTime(0.24 * M, t + 0.8);
        bg.gain.exponentialRampToValueAtTime(0.0001, t + bEnd);
        shaper.connect(blp);
        blp.connect(bg);
        bg.connect(this.sfxBus);
        [43.65, 87.31, 87.57, 130.81, 174.61, 207.65].map((x) => x * this.keyRatio).forEach((fr) => {
          const o = c.createOscillator();
          o.type = 'sawtooth';
          o.frequency.setValueAtTime(fr * 1.03, t);
          o.frequency.exponentialRampToValueAtTime(fr, t + 0.4);
          const og = c.createGain();
          og.gain.value = 0.22;
          o.connect(og);
          og.connect(shaper);
          o.start(t);
          o.stop(t + bEnd + 0.2);
        });

        // 3. uderzenie
        const n = this.noiseSrc(t, 1.5);
        const nlp = c.createBiquadFilter();
        nlp.type = 'lowpass';
        nlp.frequency.setValueAtTime(6000, t);
        nlp.frequency.exponentialRampToValueAtTime(180, t + 1.2);
        const ngn = c.createGain();
        ngn.gain.setValueAtTime(0.85 * M, t);
        ngn.gain.exponentialRampToValueAtTime(0.0001, t + 1.3);
        n.connect(nlp);
        nlp.connect(ngn);
        ngn.connect(this.sfxBus);

        // 4. pękające serce – odłamki szkła
        const sh = this.noiseSrc(t + 0.04, 0.7);
        const hp = c.createBiquadFilter();
        hp.type = 'highpass';
        hp.frequency.value = 3500;
        const shg = c.createGain();
        shg.gain.setValueAtTime(0.32, t + 0.04);
        shg.gain.exponentialRampToValueAtTime(0.0001, t + 0.64);
        sh.connect(hp);
        hp.connect(shg);
        shg.connect(this.sfxBus);
        for (let i = 0; i < (big ? 36 : 26); i++) {
          const tt = t + 0.03 + Math.pow(Math.random(), 1.6) * 0.7;
          const o = c.createOscillator();
          o.type = 'sine';
          o.frequency.setValueAtTime(2200 + Math.random() * 5200, tt);
          const og = c.createGain();
          const end = tt + 0.08 + Math.random() * 0.4;
          og.gain.setValueAtTime(0.0001, tt);
          og.gain.linearRampToValueAtTime(0.04 + Math.random() * 0.04, tt + 0.002);
          og.gain.exponentialRampToValueAtTime(0.0001, end);
          o.connect(og);
          if (c.createStereoPanner) {
            const p = c.createStereoPanner();
            p.pan.value = Math.random() * 2 - 1;
            og.connect(p);
            p.connect(this.sfxBus);
          } else {
            og.connect(this.sfxBus);
          }
          o.start(tt);
          o.stop(end + 0.02);
        }

        // 5. ciężki, smutny klaster fortepianu
        [43.65, 87.31, 130.81, 174.61, 207.65, 261.63, 392.00, 415.30].map((x) => x * this.keyRatio).forEach((fr, i) => {
          this.piano(fr, t + i * 0.012, 0.95, big ? 7 : 5.5, this.sfxBus);
        });

        // 6. eteryczny chór
        this.choir([261.63, 349.23, 415.30, 523.25].map((x) => x * this.keyRatio), t + 0.15, big ? 6 : 4.5, 0.14 * M);

        // 7. dzwonienie w uszach (otępienie)
        const tn = c.createOscillator();
        tn.type = 'sine';
        tn.frequency.value = 3520;
        const tg = c.createGain();
        tg.gain.setValueAtTime(0.0001, t + 0.3);
        tg.gain.linearRampToValueAtTime(0.012, t + 0.8);
        tg.gain.exponentialRampToValueAtTime(0.0001, t + 5);
        tn.connect(tg);
        tg.connect(this.dryBus);
        tn.start(t + 0.3);
        tn.stop(t + 5.1);
      }

      // uderzenie przy każdej scenie montażu
      sceneHit(idx) {
        if (!this.live()) return;
        const c = this.ctx, t = c.currentTime + 0.01;
        const ch = this.progression[idx % 4];
        const o = c.createOscillator();
        o.type = 'sine';
        o.frequency.setValueAtTime(100, t);
        o.frequency.exponentialRampToValueAtTime(30, t + 0.9);
        const g = c.createGain();
        g.gain.setValueAtTime(0.75, t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 1.1);
        o.connect(g);
        g.connect(this.dryBus);
        o.start(t);
        o.stop(t + 1.15);

        const n = this.noiseSrc(t, 0.5);
        const bp = c.createBiquadFilter();
        bp.type = 'bandpass';
        bp.frequency.value = 1100;
        bp.Q.value = 0.8;
        const ng = c.createGain();
        ng.gain.setValueAtTime(0.35, t);
        ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
        n.connect(bp);
        bp.connect(ng);
        ng.connect(this.sfxBus);

        ch.pad.forEach((f, i) => this.piano(f * 2, t + i * 0.015, 0.75, 4, this.sfxBus));
        this.piano(ch.bass * 4, t, 0.8, 4, this.sfxBus);
        this.bell(ch.arp[3] * 2, t + 0.03, 0.05, 4);
        this.strings(ch.pad, t, 2.6, 0.06, 2400, 0.08, this.sfxBus, 1.2);
      }

      playGlitchNoise(duration = 0.15) {
        if (!this.live()) return;
        const c = this.ctx, t = c.currentTime;
        const size = Math.floor(c.sampleRate * duration);
        const buffer = c.createBuffer(1, size, c.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < size; i++) data[i] = (Math.random() * 2 - 1) * Math.sin(i / 10);
        const src = c.createBufferSource();
        src.buffer = buffer;
        const filter = c.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.value = 1200;
        const g = c.createGain();
        g.gain.setValueAtTime(0.08, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + duration);
        src.connect(filter);
        filter.connect(g);
        g.connect(this.sfxBus);
        src.start(t);
      }

      toggleMute() {
        this.muted = !this.muted;
        if (this.master && this.ctx) {
          this.master.gain.setValueAtTime(this.muted ? 0 : 0.95, this.ctx.currentTime);
        }
        return this.muted;
      }
    }

    const audio = new EmotionalAudioEngine();

    /*************************************************************************
     * 17 HISTORII – scenariusze
     * {imie} / {IMIE} – imię widza, {godz} – prawdziwa godzina
     * sfx: 'nazwa' lub 'nazwa@opóźnienie_ms'
     *************************************************************************/
